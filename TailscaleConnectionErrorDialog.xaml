<Window x:Class="TailscaleConnectionErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:HidaChat.UI.Controls"
        Title="HidaChat — Tailscale Connection Status"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="500"
        MinWidth="420"
        SizeToContent="Height"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HidaChat;component/UI/Themes/FluentDark.xaml"/>
                <ResourceDictionary Source="/HidaChat;component/UI/Themes/ModernControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header with semantic warning icon -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Width="40"
                        Height="40"
                        CornerRadius="10"
                        Background="{DynamicResource WarningSubtleBrush}"
                        Margin="0,0,14,0"
                        VerticalAlignment="Center">
                    <Path Data="M1,21H23L12,2L1,21ZM13,18H11V16H13V18ZM13,14H11V10H13V14Z"
                          Fill="{DynamicResource WarningBrush}"
                          Width="20"
                          Height="20"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTitle"
                               Text="HidaChat — Tailscale Connection Status"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtHeader"
                               Text="Unable to load profile"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12.5"
                               Margin="0,2,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <!-- Diagnostic message -->
            <TextBlock Grid.Row="1"
                       x:Name="TxtMessage"
                       Text="Checking Tailscale network connectivity..."
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="13.5"
                       TextWrapping="Wrap"
                       LineHeight="20"
                       Margin="0,0,0,22"/>

            <!-- Action buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:ModernButton x:Name="BtnLogin"
                                 Content="Sign in to Tailscale"
                                 Variant="Primary"
                                 Margin="0,0,8,0"
                                 Visibility="Collapsed"
                                 Click="BtnLogin_Click"/>
                <ui:ModernButton x:Name="BtnSettings"
                                 Content="Settings"
                                 Variant="Ghost"
                                 IconKey="Settings"
                                 Margin="0,0,8,0"
                                 Click="BtnSettings_Click"/>
                <ui:ModernButton x:Name="BtnClose"
                                 Content="Close"
                                 Variant="Secondary"
                                 IsCancel="True"
                                 Margin="0,0,8,0"
                                 Click="BtnClose_Click"/>
                <ui:ModernButton x:Name="BtnRetry"
                                 Content="Retry"
                                 Variant="Primary"
                                 IconKey="Refresh"
                                 IsDefault="True"
                                 Click="BtnRetry_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
