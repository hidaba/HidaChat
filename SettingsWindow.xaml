<Window x:Class="SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HidaChat"
        mc:Ignorable="d"
        Title="Settings" 
        Height="580" 
        Width="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Effect>
        <DropShadowEffect BlurRadius="10" Color="#000" Opacity="0.4" ShadowDepth="0"/>
    </Window.Effect>

    <Window.Resources>
        <ResourceDictionary>
            <Style x:Key="SettingsCloseBtnStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2a3942"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#00a884"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Margin" Value="0,10,0,8"/>
            </Style>

            <Style x:Key="CustomCheckBoxStyle" TargetType="CheckBox">
                <Setter Property="Foreground" Value="#aebac1"/>
                <Setter Property="Margin" Value="0,4"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>

            <Style x:Key="CustomComboBoxStyle" TargetType="ComboBox">
                <Setter Property="Background" Value="#2a3942"/>
                <Setter Property="Foreground" Value="#e9edef"/>
                <Setter Property="BorderBrush" Value="#222e35"/>
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Background" Value="#2a3942"/>
                            <Setter Property="Foreground" Value="#e9edef"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#00a884"/>
                                    <Setter Property="Foreground" Value="#ffffff"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#374955"/>
                                    <Setter Property="Foreground" Value="#ffffff"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ActionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#2a3942"/>
                <Setter Property="Foreground" Value="#e9edef"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#3d525f"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AccountPlatformComboBoxStyle" TargetType="ComboBox">
                <Setter Property="Background" Value="#2a3942"/>
                <Setter Property="Foreground" Value="#8696a0"/>
                <Setter Property="BorderBrush" Value="#222e35"/>
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Background" Value="#2a3942"/>
                            <Setter Property="Foreground" Value="#8696a0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="6,4"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#00a884"/>
                                    <Setter Property="Foreground" Value="#ffffff"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#374955"/>
                                    <Setter Property="Foreground" Value="#e9edef"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DeleteBtnStyle" TargetType="Button">
                <Setter Property="Background" Value="#2a3942"/>
                <Setter Property="Foreground" Value="#ea0038"/>
                <Setter Property="BorderBrush" Value="#3d2026"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#381e24"/>
                                    <Setter Property="BorderBrush" Value="#ea0038"/>
                                    <Setter Property="Foreground" Value="#ff4d4d"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="SettingsBorder" CornerRadius="12" BorderThickness="1" BorderBrush="#2f3e46" Background="#1f2c34">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Titlebar -->
                <RowDefinition Height="45"/>
                <!-- Settings Scrollable Content -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Draggable Titlebar -->
            <Grid Grid.Row="0" x:Name="TitleBar" Background="#202c33" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock x:Name="TitleText" Text="Settings" Foreground="#e9edef" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="20,0,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                    <Button x:Name="BtnAbout" Click="BtnAbout_Click" Width="28" Height="28" Margin="0,0,5,0" ToolTip="About" Style="{StaticResource SettingsCloseBtnStyle}">
                        <TextBlock Text="ⓘ" Foreground="#8696a0" FontSize="14" FontWeight="Bold"/>
                    </Button>
                    <Button Click="BtnClose_Click" Width="28" Height="28" Style="{StaticResource SettingsCloseBtnStyle}">
                        <TextBlock Text="✕" Foreground="#8696a0" FontSize="12" FontWeight="Bold"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Scrollable Settings Page -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="10">
                <StackPanel Margin="10,0,10,15">
                    
                    <!-- THEME SECTION -->
                    <TextBlock x:Name="SectionTheme" Text="Theme" Style="{StaticResource SectionHeaderStyle}"/>
                    <Grid Margin="0,5,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LabelAppTheme" Text="App Theme Color" Foreground="#aebac1" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ComboTheme" Grid.Column="1" Width="120" SelectionChanged="ComboTheme_SelectionChanged" Style="{StaticResource CustomComboBoxStyle}">
                            <ComboBoxItem Content="System"/>
                            <ComboBoxItem Content="Light"/>
                            <ComboBoxItem Content="Dark"/>
                        </ComboBox>
                    </Grid>

                    <!-- LANGUAGE SECTION -->
                    <TextBlock x:Name="SectionLanguage" Text="Language &amp; Translation" Style="{StaticResource SectionHeaderStyle}"/>
                    <Grid Margin="0,5,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LabelSelectLanguage" Text="Select Language" Foreground="#aebac1" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ComboLanguage" Grid.Column="1" Width="150" DisplayMemberPath="Name" SelectionChanged="ComboLanguage_SelectionChanged" Style="{StaticResource CustomComboBoxStyle}"/>
                    </Grid>

                    <CheckBox x:Name="ChkTranslateMessageButton" Content="Translate message button" Checked="ChkSetting_Changed" Unchecked="ChkSetting_Changed" Margin="0,10,0,5" Style="{StaticResource CustomCheckBoxStyle}"/>
                    <CheckBox x:Name="ChkFullPageTranslation" Content="Translate entire page" Checked="ChkSetting_Changed" Unchecked="ChkSetting_Changed" Margin="0,5,0,5" Style="{StaticResource CustomCheckBoxStyle}"/>
                    <CheckBox x:Name="ChkShowTranslateAllButton" Content="Title bar translate all messages button" Checked="ChkSetting_Changed" Unchecked="ChkSetting_Changed" Margin="0,5,0,5" Style="{StaticResource CustomCheckBoxStyle}"/>

                    <!-- TRANSLATION PROVIDER & PRIVACY SECTION (TODO #69) -->
                    <CheckBox x:Name="ChkTranslationPrivacyConsent" Content="I consent to sending message text to the selected translation provider" Checked="ChkSetting_Changed" Unchecked="ChkSetting_Changed" Margin="0,8,0,8" Style="{StaticResource CustomCheckBoxStyle}"/>

                    <Grid Margin="0,4,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LabelTranslationProvider" Text="Translation Provider" Foreground="#aebac1" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ComboTranslationProvider" Grid.Column="1" Width="220" SelectionChanged="ComboTranslationProvider_SelectionChanged" Style="{StaticResource CustomComboBoxStyle}">
                            <ComboBoxItem x:Name="CbiProviderGoogle" Content="Google Translate (Cloud)" Tag="google"/>
                            <ComboBoxItem x:Name="CbiProviderLibreTranslate" Content="LibreTranslate (Self-Hosted)" Tag="libretranslate"/>
                            <ComboBoxItem x:Name="CbiProviderOllama" Content="Ollama (Local LLM)" Tag="ollama"/>
                            <ComboBoxItem x:Name="CbiProviderOpenAi" Content="OpenAI-Compatible (Custom Endpoint)" Tag="openai"/>
                        </ComboBox>
                    </Grid>

                    <!-- LibreTranslate Config Panel -->
                    <StackPanel x:Name="PanelLibreTranslate" Visibility="Collapsed" Margin="0,0,0,8">
                        <TextBlock x:Name="LabelLibreTranslateUrl" Text="Endpoint URL:" Foreground="#8696a0" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox x:Name="TxtLibreTranslateUrl" Foreground="#ffffff" Background="#111b21" BorderBrush="#2a3942" Padding="6,4" FontSize="12" LostFocus="TranslationConfig_Changed" Margin="0,0,0,6"/>
                        <TextBlock x:Name="LabelLibreTranslateApiKey" Text="API Key (optional):" Foreground="#8696a0" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox x:Name="TxtLibreTranslateApiKey" Foreground="#ffffff" Background="#111b21" BorderBrush="#2a3942" Padding="6,4" FontSize="12" LostFocus="TranslationConfig_Changed" Margin="0,0,0,6"/>
                    </StackPanel>

                    <!-- Ollama Config Panel -->
                    <StackPanel x:Name="PanelOllama" Visibility="Collapsed" Margin="0,0,0,8">
                        <TextBlock x:Name="LabelOllamaUrl" Text="Endpoint URL:" Foreground="#8696a0" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox x:Name="TxtOllamaUrl" Foreground="#ffffff" Background="#111b21" BorderBrush="#2a3942" Padding="6,4" FontSize="12" LostFocus="TranslationConfig_Changed" Margin="0,0,0,6"/>
                        <TextBlock x:Name="LabelOllamaModel" Text="Model Name:" Foreground="#8696a0" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox x:Name="TxtOllamaModel" Foreground="#ffffff" Background="#111b21" BorderBrush="#2a3942" Padding="6,4" FontSize="12" LostFocus="TranslationConfig_Changed" Margin="0,0,0,6"/>
                    </StackPanel>

                    <!-- OpenAI Config Panel -->
                    <StackPanel x:Name="PanelOpenAi" Visibility="Collapsed" Margin="0,0,0,8">
                        <TextBlock x:Name="LabelOpenAiUrl" Text="Endpoint URL:" Foreground="#8696a0" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox x:Name="TxtOpenAiUrl" Foreground="#ffffff" Background="#111b21" BorderBrush="#2a3942" Padding="6,4" FontSize="12" LostFocus="TranslationConfig_Changed" Margin="0,0,0,6"/>
                        <TextBlock x:Name="LabelOpenAiModel" Text="Model Name:" Foreground="#8696a0" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox x:Name="TxtOpenAiModel" Foreground="#ffffff" Background="#111b21" BorderBrush="#2a3942" Padding="6,4" FontSize="12" LostFocus="TranslationConfig_Changed" Margin="0,0,0,6"/>
                        <TextBlock x:Name="LabelOpenAiApiKey" Text="API Key (optional):" Foreground="#8696a0" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox x:Name="TxtOpenAiApiKey" Foreground="#ffffff" Background="#111b21" BorderBrush="#2a3942" Padding="6,4" FontSize="12" LostFocus="TranslationConfig_Changed" Margin="0,0,0,6"/>
                    </StackPanel>

                    <!-- Test Provider Button & Status Indicator -->
                    <Grid x:Name="RowTranslationTest" Margin="0,2,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnTestTranslationProvider" Content="Test Connection" Click="BtnTestTranslationProvider_Click" Style="{StaticResource ActionButtonStyle}" Height="28" Padding="12,2" FontSize="12"/>
                        <TextBlock x:Name="TxtTranslationTestStatus" Grid.Column="1" Text="" Foreground="#8696a0" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
                    </Grid>

                    <!-- NOTIFICATIONS & FOCUS SECTION (TODO #47) -->
                    <TextBlock x:Name="SectionNotifications" Text="Notifications &amp; Focus" Style="{StaticResource SectionHeaderStyle}"/>
                    <CheckBox x:Name="ChkShowMessagePopup" Content="Show message popup" Checked="ChkSetting_Changed" Unchecked="ChkSetting_Changed" Margin="0,5,0,8" Style="{StaticResource CustomCheckBoxStyle}"/>
                    
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="LabelDndMode" Text="Do Not Disturb" Foreground="#e9edef" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtDndStatus" Text="Silence all notifications and audio" Foreground="#8696a0" FontSize="11"/>
                        </StackPanel>
                        <ComboBox x:Name="ComboDndMode" Grid.Column="1" Width="160" SelectionChanged="ComboDndMode_SelectionChanged" Style="{StaticResource CustomComboBoxStyle}">
                            <ComboBoxItem x:Name="CbiDndOff" Content="Disattivata" Tag="off"/>
                            <ComboBoxItem x:Name="CbiDnd30m" Content="30 minuti" Tag="30m"/>
                            <ComboBoxItem x:Name="CbiDnd1h" Content="1 ora" Tag="1h"/>
                            <ComboBoxItem x:Name="CbiDnd2h" Content="2 ore" Tag="2h"/>
                            <ComboBoxItem x:Name="CbiDnd8h" Content="8 ore" Tag="8h"/>
                            <ComboBoxItem x:Name="CbiDndIndefinite" Content="Indefinito" Tag="indefinite"/>
                        </ComboBox>
                    </Grid>

                    <!-- ACCOUNTS MANAGEMENT SECTION -->
                    <Grid Margin="0,10,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SectionAccounts" Text="Manage Accounts" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
                        <TextBlock x:Name="TxtAccountsCount" Grid.Column="1" Text="" Foreground="#8696a0" FontSize="12" VerticalAlignment="Center"/>
                    </Grid>
                    
                    <ItemsControl x:Name="AccountsList" Margin="0,5,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,0,0,1" BorderBrush="#222e35" Padding="0,8">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Platform Icon Preview -->
                                            <Path Grid.Column="0" Data="{Binding PlatformIconData}" 
                                                  Fill="{Binding PlatformColorBrush}" 
                                                  Width="16" Height="16" Stretch="Uniform" 
                                                  VerticalAlignment="Center" Margin="0,0,10,0"/>

                                            <!-- Editable Account Name TextBox -->
                                            <TextBox Grid.Column="1" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                     LostFocus="TxtAccountName_LostFocus"
                                                     Foreground="#ffffff" Background="#2a3942" BorderBrush="#00a884" 
                                                     Padding="8,6" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="13"/>

                                            <!-- Platform Selector ComboBox -->
                                            <ComboBox Grid.Column="2" 
                                                      SelectedValuePath="Tag"
                                                      SelectedValue="{Binding Platform, Mode=TwoWay}"
                                                      SelectionChanged="ComboAccountPlatform_SelectionChanged"
                                                      Tag="{Binding Id}"
                                                      Style="{StaticResource AccountPlatformComboBoxStyle}"
                                                      Foreground="#8696a0"
                                                      VerticalAlignment="Center" Margin="0,0,10,0">
                                                <ComboBoxItem Content="WhatsApp" Tag="WhatsApp" Foreground="#8696a0"/>
                                                <ComboBoxItem Content="Telegram" Tag="Telegram" Foreground="#8696a0"/>
                                                <ComboBoxItem Content="OpenClaw" Tag="OpenClaw" Foreground="#8696a0"/>
                                                <ComboBoxItem Content="Hermes Agent" Tag="Hermes" Foreground="#8696a0"/>
                                            </ComboBox>

                                            <!-- Delete Account Button -->
                                            <Button Grid.Column="3" Content="Delete" Click="BtnDeleteAccount_Click" Tag="{Binding Id}" Style="{StaticResource DeleteBtnStyle}"/>
                                        </Grid>

                                        <!-- AI Gateway & Tailscale Panel (OpenClaw / Hermes Agent) -->
                                        <Border Visibility="{Binding AgentSettingsVisibility}" 
                                                Background="#1f2c34" CornerRadius="6" Padding="10,8" Margin="26,6,0,2">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Server URL / Tailscale:" Foreground="#8696a0" FontSize="12" VerticalAlignment="Center" Width="140"/>
                                                    <TextBox Grid.Column="1" Text="{Binding ServerUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             LostFocus="TxtServerUrl_LostFocus"
                                                             Foreground="#ffffff" Background="#111b21" BorderBrush="#2a3942"
                                                             Padding="6,4" FontSize="12" ToolTip="{Binding ServerUrlTooltip}"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding AuthTokenLabel}" Foreground="#8696a0" FontSize="12" VerticalAlignment="Center" Width="140"/>
                                                    <TextBox Grid.Column="1" Text="{Binding AuthToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             LostFocus="TxtAuthToken_LostFocus"
                                                             Foreground="#ffffff" Background="#111b21" BorderBrush="#2a3942"
                                                             Padding="6,4" FontSize="12" ToolTip="{Binding AuthTokenTooltip}"/>
                                                </Grid>
                                                <CheckBox Content="Usa nodo Tailscale integrato (tsnet portatile)" 
                                                          IsChecked="{Binding TailscaleIntegration, Mode=TwoWay}" 
                                                          Click="ChkAccountTailscale_Click" Tag="{Binding Id}" 
                                                          Margin="0,2,0,8" Foreground="#e9edef" FontSize="12"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding ConnectionStatusText}" Foreground="{Binding ConnectionStatusBrush}" 
                                                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <Button Content="Test Connessione" Click="BtnTestConnection_Click" Tag="{Binding Id}"
                                                            Style="{StaticResource ActionButtonStyle}" Height="26" Padding="10,2" FontSize="12"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Downgrade Notice Banner -->
                    <Border x:Name="BorderDowngradeNotice" Background="#33ffb300" BorderBrush="#ffb300" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠️" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtDowngradeNotice" TextWrapping="Wrap" Foreground="#ffe082" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnAddAccountSettings" Content="Add account" Click="BtnAddAccountSettings_Click" Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Left"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="LabelMaxAccounts" Text="Max accounts:" Foreground="#aebac1" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                            <ComboBox x:Name="ComboMaxAccounts" Width="75" SelectionChanged="ComboMaxAccounts_SelectionChanged" Style="{StaticResource CustomComboBoxStyle}">
                                <ComboBoxItem Content="2" Tag="2"/>
                                <ComboBoxItem Content="3" Tag="3"/>
                                <ComboBoxItem Content="4" Tag="4"/>
                                <ComboBoxItem Content="5" Tag="5"/>
                                <ComboBoxItem Content="6" Tag="6"/>
                                <ComboBoxItem Content="7" Tag="7"/>
                                <ComboBoxItem Content="8" Tag="8"/>
                                <ComboBoxItem Content="9" Tag="9"/>
                                <ComboBoxItem Content="10" Tag="10"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- TAILSCALE EMBEDDED (tsnet) SECTION -->
                    <Border Background="#202c33" CornerRadius="8" Padding="12,10" Margin="0,0,0,15">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Tailscale Integrato (tsnet)" FontWeight="SemiBold" FontSize="14" Foreground="#e9edef" Margin="0,0,10,0"/>
                                    <Border x:Name="BadgeTsnetStatus" CornerRadius="4" Padding="6,2" Background="#2a3942" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtTsnetStatus" Text="Non attivo" Foreground="#8696a0" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                                <Button x:Name="BtnTsnetLogin" Grid.Column="1" Content="Accedi a Tailscale" Click="BtnTsnetLogin_Click" 
                                        Style="{StaticResource ActionButtonStyle}" Height="26" Padding="10,2" FontSize="12" Visibility="Collapsed"/>
                            </Grid>

                            <TextBlock Text="Consente di raggiungere host sulla tua Tailnet privata (*.ts.net o 100.x.y.z) in modalità 100% portatile senza installare Tailscale sulla macchina." 
                                       Foreground="#8696a0" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="AuthKey (opzionale):" Foreground="#8696a0" FontSize="12" VerticalAlignment="Center" Width="130"/>
                                <TextBox x:Name="TxtTsnetAuthKey" Grid.Column="1" LostFocus="TxtTsnetAuthKey_LostFocus"
                                         Foreground="#ffffff" Background="#111b21" BorderBrush="#2a3942"
                                         Padding="6,4" FontSize="12" ToolTip="Chiave tskey-auth-... per registrazione automatica del nodo senza login browser"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- CUSTOM CSS SECTION (TODO #43) -->
                    <TextBlock x:Name="SectionCustomCss" Text="Custom CSS" Style="{StaticResource SectionHeaderStyle}"/>
                    <CheckBox x:Name="ChkEnableCustomCss" Content="Enable custom CSS rules" Checked="ChkEnableCustomCss_Changed" Unchecked="ChkEnableCustomCss_Changed" Margin="0,5,0,8" Style="{StaticResource CustomCheckBoxStyle}"/>
                    
                    <Border x:Name="CustomCssBorder" CornerRadius="6" BorderThickness="1" BorderBrush="#00a884" Background="#111b21" Margin="0,0,0,8">
                        <TextBox x:Name="TxtCustomCss" 
                                 Height="110" 
                                 AcceptsReturn="True" 
                                 AcceptsTab="True" 
                                 TextWrapping="Wrap" 
                                 VerticalScrollBarVisibility="Auto" 
                                 FontFamily="Consolas, Cascadia Mono, Courier New, monospace" 
                                 FontSize="12" 
                                 Foreground="#25d366" 
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 Padding="8"/>
                    </Border>

                    <!-- Presets and Apply Action Bar -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnPresetOled" Content="OLED" Click="BtnPresetOled_Click" Style="{StaticResource ActionButtonStyle}" Padding="8,4" FontSize="11" Margin="0,0,5,0"/>
                            <Button x:Name="BtnPresetCompact" Content="Compatto" Click="BtnPresetCompact_Click" Style="{StaticResource ActionButtonStyle}" Padding="8,4" FontSize="11" Margin="0,0,5,0"/>
                            <Button x:Name="BtnPresetFont" Content="Font" Click="BtnPresetFont_Click" Style="{StaticResource ActionButtonStyle}" Padding="8,4" FontSize="11" Margin="0,0,5,0"/>
                            <Button x:Name="BtnPresetReset" Content="Svuota" Click="BtnPresetReset_Click" Style="{StaticResource ActionButtonStyle}" Padding="8,4" FontSize="11"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="BtnApplyCustomCss" Content="Applica CSS" Click="BtnApplyCustomCss_Click" Style="{StaticResource ActionButtonStyle}" Background="#00a884" Foreground="#ffffff" FontWeight="Bold" Padding="14,6"/>
                    </Grid>

                    <!-- SPELLCHECKER SECTION (TODO #44) -->
                    <TextBlock x:Name="SectionSpellcheck" Text="Spellchecker" Style="{StaticResource SectionHeaderStyle}"/>
                    <CheckBox x:Name="ChkEnableSpellcheck" Content="Enable native spellchecker in chat inputs" Checked="ChkEnableSpellcheck_Changed" Unchecked="ChkEnableSpellcheck_Changed" Margin="0,5,0,8" Style="{StaticResource CustomCheckBoxStyle}"/>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LabelSpellcheckLanguage" Text="Dictionary language" Foreground="#aebac1" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ComboSpellcheckLanguage" Grid.Column="1" Width="180" SelectionChanged="ComboSpellcheckLanguage_SelectionChanged" Style="{StaticResource CustomComboBoxStyle}">
                            <ComboBoxItem x:Name="CbiSpellAuto" Content="Automatic (app language)" Tag="auto"/>
                            <ComboBoxItem Content="English (en-US)" Tag="en"/>
                            <ComboBoxItem Content="Italiano (it-IT)" Tag="it"/>
                            <ComboBoxItem Content="Français (fr-FR)" Tag="fr"/>
                            <ComboBoxItem Content="Español (es-ES)" Tag="es"/>
                            <ComboBoxItem Content="Deutsch (de-DE)" Tag="de"/>
                        </ComboBox>
                    </Grid>
                    <TextBlock x:Name="TxtSpellcheckHint" Text="Changes will apply when reloading tabs or restarting HidaChat." Foreground="#8696a0" FontSize="11" FontStyle="Italic" Margin="0,0,0,15"/>

                    <!-- NETWORK DRIVE SESSION STAGING (TODO #73) -->
                    <TextBlock x:Name="SectionNetworkStaging" Text="Network Drives" Style="{StaticResource SectionHeaderStyle}"/>
                    <CheckBox x:Name="ChkEnableNetworkStaging" Content="Enable local staging for network drives" Checked="ChkEnableNetworkStaging_Changed" Unchecked="ChkEnableNetworkStaging_Changed" Margin="0,5,0,4" Style="{StaticResource CustomCheckBoxStyle}"/>
                    <TextBlock x:Name="TxtNetworkStagingHint" Text="Improves session stability and prevents WhatsApp disconnection when running from network shares (SMB/UNC)." Foreground="#8696a0" FontSize="11" FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,15"/>

                    <!-- TAB HIBERNATION SECTION (TODO #50) -->
                    <TextBlock x:Name="SectionHibernation" Text="Tab Hibernation" Style="{StaticResource SectionHeaderStyle}"/>
                    <CheckBox x:Name="ChkEnableTabHibernation" Content="Enable inactive tab hibernation" Checked="ChkEnableTabHibernation_Changed" Unchecked="ChkEnableTabHibernation_Changed" Margin="0,5,0,5" Style="{StaticResource CustomCheckBoxStyle}"/>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LabelTabHibernationTimeout" Text="Inactivity timeout:" Foreground="#aebac1" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ComboTabHibernationTimeout" Grid.Column="1" Width="180" SelectionChanged="ComboTabHibernationTimeout_SelectionChanged" Style="{StaticResource CustomComboBoxStyle}">
                            <ComboBoxItem Content="15 min" Tag="15"/>
                            <ComboBoxItem Content="30 min" Tag="30"/>
                            <ComboBoxItem Content="60 min" Tag="60"/>
                        </ComboBox>
                    </Grid>
                    <TextBlock x:Name="TxtTabHibernationHint" Text="Reduces RAM usage by suspending background tabs when idle. They resume instantly when selected." Foreground="#8696a0" FontSize="11" FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,15"/>

                    <!-- CACHE & STORAGE (TODO #71 & #72) -->
                    <TextBlock x:Name="SectionCache" Text="Cache &amp; Storage" Style="{StaticResource SectionHeaderStyle}"/>
                    <Grid Margin="0,5,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LabelDiskCacheLimit" Text="Chromium disk cache limit:" Foreground="#aebac1" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ComboDiskCacheLimit" Grid.Column="1" Width="180" SelectionChanged="ComboDiskCacheLimit_SelectionChanged" Style="{StaticResource CustomComboBoxStyle}">
                            <ComboBoxItem Content="50 MB (Compatto)" Tag="50"/>
                            <ComboBoxItem Content="128 MB" Tag="128"/>
                            <ComboBoxItem Content="256 MB (Consigliato)" Tag="256"/>
                            <ComboBoxItem Content="512 MB" Tag="512"/>
                            <ComboBoxItem Content="1024 MB (1 GB)" Tag="1024"/>
                            <ComboBoxItem Content="Illimitata" Tag="0"/>
                        </ComboBox>
                    </Grid>
                    <TextBlock x:Name="TxtDiskCacheLimitHint" Text="Limits disk space used by Chromium HTTP cache per profile (applied upon tab reload)." Foreground="#8696a0" FontSize="11" FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <!-- Hot Compaction (TODO #104) -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtOptimizeStorageHint" Text="Performs surgical live cache compaction (HTTP disk cache and Service Worker CacheStorage) without logging out accounts." Foreground="#8696a0" FontSize="11" FontStyle="Italic" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Grid.Column="1" x:Name="BtnOptimizeStorage" Content="Optimize Space" Click="BtnOptimizeStorage_Click" Style="{StaticResource ActionButtonStyle}" Height="28" Padding="12,2" FontSize="12"/>
                    </Grid>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtSmartCleanCacheHint" Text="Deletes temporary files, HTTP cache, shaders and GPU cache without logging out (cookies, sessions and IndexedDB remain intact)." Foreground="#8696a0" FontSize="11" FontStyle="Italic" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Grid.Column="1" x:Name="BtnSmartCleanCache" Content="Pulisci Cache" Click="BtnSmartCleanCache_Click" Style="{StaticResource ActionButtonStyle}" Height="28" Padding="12,2" FontSize="12"/>
                    </Grid>

                    <!-- UPDATES SECTION -->
                    <TextBlock x:Name="SectionUpdates" Text="Updates" Style="{StaticResource SectionHeaderStyle}"/>
                    <CheckBox x:Name="ChkUseBetaChannel" Content="Use beta update channel" Checked="ChkUseBetaChannel_Changed" Unchecked="ChkUseBetaChannel_Changed" Margin="0,5,0,10" Style="{StaticResource CustomCheckBoxStyle}"/>


                    <!-- DEVELOPER TOOLS & CACHE -->
                    <TextBlock x:Name="SectionDevTools" Text="DevTools" Style="{StaticResource SectionHeaderStyle}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Button x:Name="BtnDebugTab" Content="Debug active tab" Click="BtnDevTools_Click" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0"/>
                        <Button x:Name="BtnCheckUpdates" Content="Check Now" Click="BtnCheckUpdates_Click" Style="{StaticResource ActionButtonStyle}"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>

</Window>
