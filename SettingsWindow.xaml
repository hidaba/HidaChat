<Window x:Class="SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:HidaChat.UI.Controls"
        mc:Ignorable="d"
        Title="Settings"
        Width="860"
        Height="660"
        MinWidth="720"
        MinHeight="560"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        PreviewKeyDown="SettingsWindow_PreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HidaChat;component/UI/Themes/FluentDark.xaml"/>
                <ResourceDictionary Source="/HidaChat;component/UI/Themes/ModernControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Fluent CheckBox style bound to semantic theme tokens -->
            <Style x:Key="SettingsCheckBoxStyle" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="13.5"/>
                <Setter Property="Margin" Value="0,6"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>

            <Style x:Key="SettingsRowLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="FontSize" Value="13.5"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="SettingsHintTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,6,0,0"/>
            </Style>

            <Style x:Key="SettingsDividerStyle" TargetType="Border">
                <Setter Property="Height" Value="1"/>
                <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}"/>
                <Setter Property="Margin" Value="0,12"/>
            </Style>

            <Style x:Key="AccentSwatchButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="24"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="SwatchRing"
                                    CornerRadius="12"
                                    Padding="2"
                                    BorderThickness="2"
                                    BorderBrush="Transparent"
                                    Background="Transparent">
                                <Ellipse Fill="{TemplateBinding Background}"
                                         Stroke="{DynamicResource BorderStrongBrush}"
                                         StrokeThickness="1"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="SwatchRing" Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="SwatchRing" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="225"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Fluent Navigation Sidebar + Version Footer -->
        <Grid Grid.Column="0" Background="{DynamicResource SurfaceBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ui:NavigationSidebar x:Name="Sidebar"
                                  Grid.Row="0"
                                  HeaderTitle="HidaChat"
                                  HeaderSubtitle="Settings"
                                  NavigationSelected="Sidebar_NavigationSelected"/>

            <Border Grid.Row="1"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,1,1,0"
                    Padding="16,10">
                <TextBlock x:Name="TxtSidebarVersion"
                           Text="HidaChat"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="11.5"
                           HorizontalAlignment="Left"
                           TextTrimming="CharacterEllipsis"/>
            </Border>
        </Grid>

        <!-- Right Main Content Area -->
        <Grid Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Context Header Bar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock x:Name="TxtPageTitle"
                                   Text="General"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TxtPageSubtitle"
                                   Text="Theme, language, notifications, and spellchecker"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <ui:ModernButton x:Name="BtnAbout"
                                     Grid.Column="1"
                                     Variant="Ghost"
                                     IconKey="Info"
                                     Content="About"
                                     Click="BtnAbout_Click"
                                     AutomationProperties.Name="About HidaChat"
                                     VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Categorized Content Panels Host -->
            <Grid Grid.Row="1">

                <!-- ========================================== -->
                <!-- PANEL 1: GENERAL                           -->
                <!-- ========================================== -->
                <ScrollViewer x:Name="PanelGeneral"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="24,20"
                              Visibility="Visible">
                    <StackPanel>
                        <!-- Card 1: Theme & Accent -->
                        <ui:ModernCard x:Name="CardTheme" Header="Theme" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LabelAppTheme"
                                               Text="App Theme Color"
                                               Style="{StaticResource SettingsRowLabelStyle}"
                                               Margin="0,0,12,0"/>
                                    <ui:ModernComboBox x:Name="ComboTheme"
                                                       Grid.Column="1"
                                                       Width="160"
                                                       SelectionChanged="ComboTheme_SelectionChanged">
                                        <ComboBoxItem Content="System"/>
                                        <ComboBoxItem Content="Light"/>
                                        <ComboBoxItem Content="Dark"/>
                                    </ui:ModernComboBox>
                                </Grid>

                                <Border Style="{StaticResource SettingsDividerStyle}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LabelAccentColor"
                                               Text="Accent Color"
                                               Style="{StaticResource SettingsRowLabelStyle}"
                                               Margin="0,0,12,0"/>
                                    <StackPanel x:Name="AccentSwatchesPanel"
                                                Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button x:Name="BtnAccentEmerald" Style="{StaticResource AccentSwatchButtonStyle}" Click="BtnAccentSwatch_Click" ToolTip="HidaChat Emerald" AutomationProperties.Name="HidaChat Emerald Accent"/>
                                        <Button x:Name="BtnAccentBlue" Style="{StaticResource AccentSwatchButtonStyle}" Click="BtnAccentSwatch_Click" ToolTip="Fluent Blue" AutomationProperties.Name="Fluent Blue Accent"/>
                                        <Button x:Name="BtnAccentViolet" Style="{StaticResource AccentSwatchButtonStyle}" Click="BtnAccentSwatch_Click" ToolTip="Violet" AutomationProperties.Name="Violet Accent"/>
                                        <Button x:Name="BtnAccentTeal" Style="{StaticResource AccentSwatchButtonStyle}" Click="BtnAccentSwatch_Click" ToolTip="Teal" AutomationProperties.Name="Teal Accent"/>
                                        <Button x:Name="BtnAccentRose" Style="{StaticResource AccentSwatchButtonStyle}" Margin="0" Click="BtnAccentSwatch_Click" ToolTip="Rose" AutomationProperties.Name="Rose Accent"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ui:ModernCard>

                        <!-- Card 2: Language & Spellchecker -->
                        <ui:ModernCard x:Name="CardLanguage" Header="Language &amp; Input" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LabelSelectLanguage"
                                               Text="Interface Language"
                                               Style="{StaticResource SettingsRowLabelStyle}"
                                               Margin="0,0,12,0"/>
                                    <ui:ModernComboBox x:Name="ComboLanguage"
                                                       Grid.Column="1"
                                                       Width="190"
                                                       DisplayMemberPath="Name"
                                                       SelectionChanged="ComboLanguage_SelectionChanged"/>
                                </Grid>

                                <Border Style="{StaticResource SettingsDividerStyle}"/>

                                <TextBlock x:Name="SectionSpellcheck"
                                           Text="Spellchecker"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,0,0,6"/>

                                <CheckBox x:Name="ChkEnableSpellcheck"
                                          Content="Enable native spellchecker in chat inputs"
                                          Checked="ChkEnableSpellcheck_Changed"
                                          Unchecked="ChkEnableSpellcheck_Changed"
                                          Style="{StaticResource SettingsCheckBoxStyle}"/>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LabelSpellcheckLanguage"
                                               Text="Dictionary language"
                                               Style="{StaticResource SettingsRowLabelStyle}"
                                               Margin="0,0,12,0"/>
                                    <ui:ModernComboBox x:Name="ComboSpellcheckLanguage"
                                                       Grid.Column="1"
                                                       Width="210"
                                                       SelectionChanged="ComboSpellcheckLanguage_SelectionChanged">
                                        <ComboBoxItem x:Name="CbiSpellAuto" Content="Automatic (app language)" Tag="auto"/>
                                        <ComboBoxItem Content="English (en-US)" Tag="en"/>
                                        <ComboBoxItem Content="Italiano (it-IT)" Tag="it"/>
                                        <ComboBoxItem Content="Français (fr-FR)" Tag="fr"/>
                                        <ComboBoxItem Content="Español (es-ES)" Tag="es"/>
                                        <ComboBoxItem Content="Deutsch (de-DE)" Tag="de"/>
                                    </ui:ModernComboBox>
                                </Grid>

                                <TextBlock x:Name="TxtSpellcheckHint"
                                           Text="Changes will apply when reloading tabs or restarting HidaChat."
                                           Style="{StaticResource SettingsHintTextStyle}"/>
                            </StackPanel>
                        </ui:ModernCard>

                        <!-- Card 3: Notifications & Focus -->
                        <ui:ModernCard x:Name="CardNotifications" Header="Notifications &amp; Focus">
                            <StackPanel>
                                <CheckBox x:Name="ChkShowMessagePopup"
                                          Content="Show message popup"
                                          Checked="ChkSetting_Changed"
                                          Unchecked="ChkSetting_Changed"
                                          Style="{StaticResource SettingsCheckBoxStyle}"/>

                                <Border Style="{StaticResource SettingsDividerStyle}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock x:Name="LabelDndMode"
                                                   Text="Do Not Disturb"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TxtDndStatus"
                                                   Text="Silence all notifications and audio"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="12"
                                                   Margin="0,2,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ui:ModernComboBox x:Name="ComboDndMode"
                                                       Grid.Column="1"
                                                       Width="180"
                                                       SelectionChanged="ComboDndMode_SelectionChanged">
                                        <ComboBoxItem x:Name="CbiDndOff" Content="Disabled" Tag="off"/>
                                        <ComboBoxItem x:Name="CbiDnd30m" Content="30 minutes" Tag="30m"/>
                                        <ComboBoxItem x:Name="CbiDnd1h" Content="1 hour" Tag="1h"/>
                                        <ComboBoxItem x:Name="CbiDnd2h" Content="2 hours" Tag="2h"/>
                                        <ComboBoxItem x:Name="CbiDnd8h" Content="8 hours" Tag="8h"/>
                                        <ComboBoxItem x:Name="CbiDndIndefinite" Content="Until turned off" Tag="indefinite"/>
                                    </ui:ModernComboBox>
                                </Grid>
                            </StackPanel>
                        </ui:ModernCard>
                    </StackPanel>
                </ScrollViewer>

                <!-- ========================================== -->
                <!-- PANEL 2: ACCOUNTS                          -->
                <!-- ========================================== -->
                <ScrollViewer x:Name="PanelAccounts"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="24,20"
                              Visibility="Collapsed">
                    <StackPanel>
                        <!-- Accounts Toolbar Card -->
                        <ui:ModernCard Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ui:ModernButton x:Name="BtnAddAccountSettings"
                                                 Content="Add Account"
                                                 Variant="Primary"
                                                 IconKey="Plus"
                                                 HorizontalAlignment="Left"
                                                 Click="BtnAddAccountSettings_Click"/>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:StatusBadge x:Name="BadgeAccountsCount"
                                                    Text=""
                                                    Severity="Neutral"
                                                    Margin="0,0,12,0"/>
                                    <TextBlock x:Name="LabelMaxAccounts"
                                               Text="Max accounts:"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               FontSize="13"/>
                                    <ui:ModernComboBox x:Name="ComboMaxAccounts"
                                                       Width="82"
                                                       SelectionChanged="ComboMaxAccounts_SelectionChanged">
                                        <ComboBoxItem Content="2" Tag="2"/>
                                        <ComboBoxItem Content="3" Tag="3"/>
                                        <ComboBoxItem Content="4" Tag="4"/>
                                        <ComboBoxItem Content="5" Tag="5"/>
                                        <ComboBoxItem Content="6" Tag="6"/>
                                        <ComboBoxItem Content="7" Tag="7"/>
                                        <ComboBoxItem Content="8" Tag="8"/>
                                        <ComboBoxItem Content="9" Tag="9"/>
                                        <ComboBoxItem Content="10" Tag="10"/>
                                    </ui:ModernComboBox>
                                </StackPanel>
                            </Grid>
                        </ui:ModernCard>

                        <!-- Downgrade Notice Banner (Semantic Warning Tokens) -->
                        <Border x:Name="BorderDowngradeNotice"
                                Background="{DynamicResource WarningSubtleBrush}"
                                BorderBrush="{DynamicResource WarningBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,10"
                                Margin="0,0,0,14"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0"
                                      Data="M1,21H23L12,2L1,21ZM13,18H11V16H13V18ZM13,14H11V10H13V14Z"
                                      Fill="{DynamicResource WarningBrush}"
                                      Width="16"
                                      Height="16"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0"/>
                                <TextBlock x:Name="TxtDowngradeNotice"
                                           Grid.Column="1"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource WarningBrush}"
                                           FontSize="12.5"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="SectionAccounts"
                                   Text="Configured Accounts"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,10"/>

                        <!-- Accounts ItemsControl -->
                        <ItemsControl x:Name="AccountsList" Margin="0,0,0,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            Background="{DynamicResource SurfaceBrush}"
                                            Padding="14"
                                            Margin="0,0,0,12"
                                            SnapsToDevicePixels="True">
                                        <StackPanel>
                                            <!-- Row 1: Account Header -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Platform Icon Preview -->
                                                <Border Grid.Column="0"
                                                        Width="36"
                                                        Height="36"
                                                        CornerRadius="8"
                                                        Background="{DynamicResource AppBackgroundBrush}"
                                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                        BorderThickness="1"
                                                        Margin="0,0,10,0"
                                                        VerticalAlignment="Center">
                                                    <Path Data="{Binding PlatformIconData}"
                                                          Fill="{Binding PlatformColorBrush}"
                                                          Width="18"
                                                          Height="18"
                                                          Stretch="Uniform"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Editable Account Name -->
                                                <ui:ModernTextBox Grid.Column="1"
                                                                  Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  LostFocus="TxtAccountName_LostFocus"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,0,10,0"/>

                                                <!-- Platform Selector -->
                                                <ui:ModernComboBox Grid.Column="2"
                                                                   SelectedValuePath="Tag"
                                                                   SelectedValue="{Binding Platform, Mode=TwoWay}"
                                                                   SelectionChanged="ComboAccountPlatform_SelectionChanged"
                                                                   PreviewMouseWheel="ComboAccountPlatform_PreviewMouseWheel"
                                                                   Tag="{Binding Id}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,10,0">
                                                    <ComboBoxItem Content="WhatsApp" Tag="WhatsApp"/>
                                                    <ComboBoxItem Content="Telegram" Tag="Telegram"/>
                                                    <ComboBoxItem Content="Discord" Tag="Discord"/>
                                                    <ComboBoxItem Content="OpenClaw" Tag="OpenClaw"/>
                                                    <ComboBoxItem Content="Hermes Agent" Tag="Hermes"/>
                                                </ui:ModernComboBox>

                                                <!-- Delete Account Button -->
                                                <ui:ModernButton Grid.Column="3"
                                                                 x:Name="BtnDeleteAccount"
                                                                 Content="Delete"
                                                                 Variant="Danger"
                                                                 IconKey="Trash"
                                                                 Click="BtnDeleteAccount_Click"
                                                                 Tag="{Binding Id}"
                                                                 Padding="12,6"
                                                                 MinHeight="36"/>
                                            </Grid>

                                            <!-- Row 2: AI Gateway & Tailscale Panel (OpenClaw / Hermes Agent) -->
                                            <Border Visibility="{Binding AgentSettingsVisibility}"
                                                    Background="{DynamicResource AppBackgroundBrush}"
                                                    CornerRadius="6"
                                                    BorderThickness="1"
                                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                    Padding="14,12"
                                                    Margin="0,12,0,0">
                                                <StackPanel>
                                                    <ui:ModernTextBox Label="Server URL / Tailscale"
                                                                      Placeholder="https://gateway.ts.net"
                                                                      Text="{Binding ServerUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      LostFocus="TxtServerUrl_LostFocus"
                                                                      ToolTip="{Binding ServerUrlTooltip}"
                                                                      Margin="0,0,0,10"/>

                                                    <ui:ModernTextBox Label="{Binding AuthTokenLabel}"
                                                                      Placeholder="Bearer token..."
                                                                      Text="{Binding AuthToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      LostFocus="TxtAuthToken_LostFocus"
                                                                      ToolTip="{Binding AuthTokenTooltip}"
                                                                      Margin="0,0,0,10"/>

                                                    <CheckBox x:Name="ChkAccountTailscale"
                                                              Content="Use embedded Tailscale node (tsnet portable)"
                                                              IsChecked="{Binding TailscaleIntegration, Mode=TwoWay}"
                                                              Click="ChkAccountTailscale_Click"
                                                              Tag="{Binding Id}"
                                                              Style="{StaticResource SettingsCheckBoxStyle}"
                                                              Margin="0,2,0,4"/>

                                                    <CheckBox x:Name="ChkAccountInsecureTls"
                                                              Content="Bypass SSL/TLS certificate verification (insecure)"
                                                              IsChecked="{Binding AllowInsecureTls, Mode=TwoWay}"
                                                              Click="ChkAccountInsecureTls_Click"
                                                              Tag="{Binding Id}"
                                                              Style="{StaticResource SettingsCheckBoxStyle}"
                                                              Margin="0,2,0,8"
                                                              ToolTip="Enable only if the gateway server uses self-signed certificates without trusted CA."/>

                                                    <Grid Margin="0,4,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding ConnectionStatusText}"
                                                                   ToolTip="{Binding ConnectionStatusTooltip}"
                                                                   Foreground="{Binding ConnectionStatusBrush}"
                                                                   FontSize="12.5"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,0,10,0"/>
                                                        <ui:ModernButton Grid.Column="1"
                                                                         x:Name="BtnTestAccountConnection"
                                                                         Content="Test Connection"
                                                                         Variant="Secondary"
                                                                         IconKey="Refresh"
                                                                         Click="BtnTestConnection_Click"
                                                                         Tag="{Binding Id}"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ========================================== -->
                <!-- PANEL 3: TRANSLATION                       -->
                <!-- ========================================== -->
                <ScrollViewer x:Name="PanelTranslation"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="24,20"
                              Visibility="Collapsed">
                    <StackPanel>
                        <!-- Card 1: Display Controls -->
                        <ui:ModernCard x:Name="CardTranslationControls" Header="Display Controls" Margin="0,0,0,16">
                            <StackPanel>
                                <CheckBox x:Name="ChkTranslateMessageButton"
                                          Content="Translate message button"
                                          Checked="ChkSetting_Changed"
                                          Unchecked="ChkSetting_Changed"
                                          Style="{StaticResource SettingsCheckBoxStyle}"/>
                                <CheckBox x:Name="ChkFullPageTranslation"
                                          Content="Translate entire page"
                                          Checked="ChkSetting_Changed"
                                          Unchecked="ChkSetting_Changed"
                                          Style="{StaticResource SettingsCheckBoxStyle}"/>
                                <CheckBox x:Name="ChkShowTranslateAllButton"
                                          Content="Title bar translate all messages button"
                                          Checked="ChkSetting_Changed"
                                          Unchecked="ChkSetting_Changed"
                                          Style="{StaticResource SettingsCheckBoxStyle}"/>
                            </StackPanel>
                        </ui:ModernCard>

                        <!-- Card 2: Translation Provider & Privacy -->
                        <ui:ModernCard x:Name="CardTranslationProvider" Header="Translation Provider">
                            <StackPanel>
                                <CheckBox x:Name="ChkTranslationPrivacyConsent"
                                          Content="I consent to sending message text to the selected translation provider"
                                          Checked="ChkSetting_Changed"
                                          Unchecked="ChkSetting_Changed"
                                          Style="{StaticResource SettingsCheckBoxStyle}"
                                          Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LabelTranslationProvider"
                                               Text="Translation Provider"
                                               Style="{StaticResource SettingsRowLabelStyle}"
                                               Margin="0,0,12,0"/>
                                    <ui:ModernComboBox x:Name="ComboTranslationProvider"
                                                       Grid.Column="1"
                                                       Width="260"
                                                       SelectionChanged="ComboTranslationProvider_SelectionChanged">
                                        <ComboBoxItem x:Name="CbiProviderGoogle" Content="Google Translate (Cloud)" Tag="google"/>
                                        <ComboBoxItem x:Name="CbiProviderLibreTranslate" Content="LibreTranslate (Self-Hosted)" Tag="libretranslate"/>
                                        <ComboBoxItem x:Name="CbiProviderOllama" Content="Ollama (Local LLM)" Tag="ollama"/>
                                        <ComboBoxItem x:Name="CbiProviderOpenAi" Content="OpenAI-Compatible (Custom Endpoint)" Tag="openai"/>
                                    </ui:ModernComboBox>
                                </Grid>

                                <!-- LibreTranslate Config Panel -->
                                <StackPanel x:Name="PanelLibreTranslate" Visibility="Collapsed" Margin="0,4,0,8">
                                    <ui:ModernTextBox x:Name="TxtLibreTranslateUrl"
                                                      Label="Endpoint URL"
                                                      Placeholder="http://localhost:5000"
                                                      LostFocus="TranslationConfig_Changed"
                                                      Margin="0,0,0,10"/>
                                    <ui:ModernTextBox x:Name="TxtLibreTranslateApiKey"
                                                      Label="API Key (optional)"
                                                      Placeholder="Optional API key"
                                                      LostFocus="TranslationConfig_Changed"
                                                      Margin="0,0,0,4"/>
                                </StackPanel>

                                <!-- Ollama Config Panel -->
                                <StackPanel x:Name="PanelOllama" Visibility="Collapsed" Margin="0,4,0,8">
                                    <ui:ModernTextBox x:Name="TxtOllamaUrl"
                                                      Label="Endpoint URL"
                                                      Placeholder="http://localhost:11434"
                                                      LostFocus="TranslationConfig_Changed"
                                                      Margin="0,0,0,10"/>
                                    <ui:ModernTextBox x:Name="TxtOllamaModel"
                                                      Label="Model Name"
                                                      Placeholder="llama3.2"
                                                      LostFocus="TranslationConfig_Changed"
                                                      Margin="0,0,0,4"/>
                                </StackPanel>

                                <!-- OpenAI Config Panel -->
                                <StackPanel x:Name="PanelOpenAi" Visibility="Collapsed" Margin="0,4,0,8">
                                    <ui:ModernTextBox x:Name="TxtOpenAiUrl"
                                                      Label="Endpoint URL"
                                                      Placeholder="https://api.openai.com/v1"
                                                      LostFocus="TranslationConfig_Changed"
                                                      Margin="0,0,0,10"/>
                                    <ui:ModernTextBox x:Name="TxtOpenAiModel"
                                                      Label="Model Name"
                                                      Placeholder="gpt-4o-mini"
                                                      LostFocus="TranslationConfig_Changed"
                                                      Margin="0,0,0,10"/>
                                    <ui:ModernTextBox x:Name="TxtOpenAiApiKey"
                                                      Label="API Key (optional)"
                                                      Placeholder="sk-..."
                                                      LostFocus="TranslationConfig_Changed"
                                                      Margin="0,0,0,4"/>
                                </StackPanel>

                                <Border Style="{StaticResource SettingsDividerStyle}"/>

                                <!-- Test Provider Button & Status -->
                                <Grid x:Name="RowTranslationTest">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:ModernButton x:Name="BtnTestTranslationProvider"
                                                     Content="Test Connection"
                                                     Variant="Secondary"
                                                     IconKey="Refresh"
                                                     Click="BtnTestTranslationProvider_Click"/>
                                    <TextBlock x:Name="TxtTranslationTestStatus"
                                               Grid.Column="1"
                                               Text=""
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"
                                               TextWrapping="Wrap"/>
                                </Grid>
                            </StackPanel>
                        </ui:ModernCard>
                    </StackPanel>
                </ScrollViewer>

                <!-- ========================================== -->
                <!-- PANEL 4: NETWORK & TAILSCALE               -->
                <!-- ========================================== -->
                <ScrollViewer x:Name="PanelNetwork"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="24,20"
                              Visibility="Collapsed">
                    <StackPanel>
                        <!-- Card 1: Embedded Tailscale (tsnet) -->
                        <ui:ModernCard x:Name="CardTsnet" Header="Embedded Tailscale (tsnet)" Margin="0,0,0,16">
                            <ui:ModernCard.HeaderAction>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:StatusBadge x:Name="BadgeTsnetStatus"
                                                    Text="Inactive"
                                                    Severity="Neutral"
                                                    Margin="0,0,8,0"/>
                                    <ui:ModernButton x:Name="BtnTsnetLogin"
                                                     Content="Sign in to Tailscale"
                                                     Variant="Primary"
                                                     Click="BtnTsnetLogin_Click"
                                                     Visibility="Collapsed"/>
                                </StackPanel>
                            </ui:ModernCard.HeaderAction>

                            <StackPanel>
                                <TextBlock x:Name="TxtTsnetDescription"
                                           Text="Reach hosts on your private Tailnet (*.ts.net or 100.x.y.z) in 100% portable mode without installing Tailscale on the host machine."
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,14"/>

                                <ui:ModernTextBox x:Name="TxtTsnetAuthKey"
                                                  Label="AuthKey (optional)"
                                                  Placeholder="tskey-auth-..."
                                                  LostFocus="TxtTsnetAuthKey_LostFocus"
                                                  ToolTip="Pre-authenticated tskey-auth-... key for automatic node registration without browser login"/>
                            </StackPanel>
                        </ui:ModernCard>

                        <!-- Card 2: Network Drive Staging -->
                        <ui:ModernCard x:Name="CardNetworkStaging" Header="Network Drives">
                            <StackPanel>
                                <CheckBox x:Name="ChkEnableNetworkStaging"
                                          Content="Enable local staging for network drives"
                                          Checked="ChkEnableNetworkStaging_Changed"
                                          Unchecked="ChkEnableNetworkStaging_Changed"
                                          Style="{StaticResource SettingsCheckBoxStyle}"/>
                                <TextBlock x:Name="TxtNetworkStagingHint"
                                           Text="Improves session stability and prevents WhatsApp disconnection when running from network shares (SMB/UNC)."
                                           Style="{StaticResource SettingsHintTextStyle}"/>
                            </StackPanel>
                        </ui:ModernCard>
                    </StackPanel>
                </ScrollViewer>

                <!-- ========================================== -->
                <!-- PANEL 5: APPEARANCE & CUSTOM CSS           -->
                <!-- ========================================== -->
                <ScrollViewer x:Name="PanelCss"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="24,20"
                              Visibility="Collapsed">
                    <StackPanel>
                        <ui:ModernCard x:Name="CardCustomCss" Header="Custom CSS Editor">
                            <StackPanel>
                                <CheckBox x:Name="ChkEnableCustomCss"
                                          Content="Enable custom CSS rules"
                                          Checked="ChkEnableCustomCss_Changed"
                                          Unchecked="ChkEnableCustomCss_Changed"
                                          Style="{StaticResource SettingsCheckBoxStyle}"
                                          Margin="0,0,0,12"/>

                                <Border x:Name="CustomCssBorder"
                                        CornerRadius="6"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource BorderStrongBrush}"
                                        Background="{DynamicResource AppBackgroundBrush}"
                                        Margin="0,0,0,14">
                                    <TextBox x:Name="TxtCustomCss"
                                             Height="210"
                                             AcceptsReturn="True"
                                             AcceptsTab="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             FontFamily="Cascadia Code, Consolas, Courier New, monospace"
                                             FontSize="12.5"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             CaretBrush="{DynamicResource AccentBrush}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="12"/>
                                </Border>

                                <!-- Presets & Apply Action Bar -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                        <ui:ModernButton x:Name="BtnPresetOled" Content="OLED" Variant="Secondary" Click="BtnPresetOled_Click" Margin="0,0,8,6"/>
                                        <ui:ModernButton x:Name="BtnPresetCompact" Content="Compact" Variant="Secondary" Click="BtnPresetCompact_Click" Margin="0,0,8,6"/>
                                        <ui:ModernButton x:Name="BtnPresetFont" Content="Font" Variant="Secondary" Click="BtnPresetFont_Click" Margin="0,0,8,6"/>
                                        <ui:ModernButton x:Name="BtnPresetReset" Content="Clear" Variant="Ghost" Click="BtnPresetReset_Click" Margin="0,0,8,6"/>
                                    </WrapPanel>

                                    <ui:ModernButton Grid.Column="1"
                                                     x:Name="BtnApplyCustomCss"
                                                     Content="Apply CSS"
                                                     Variant="Primary"
                                                     IconKey="Check"
                                                     Click="BtnApplyCustomCss_Click"
                                                     VerticalAlignment="Top"/>
                                </Grid>
                            </StackPanel>
                        </ui:ModernCard>
                    </StackPanel>
                </ScrollViewer>

                <!-- ========================================== -->
                <!-- PANEL 6: STORAGE & PERFORMANCE             -->
                <!-- ========================================== -->
                <ScrollViewer x:Name="PanelStorage"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="24,20"
                              Visibility="Collapsed">
                    <StackPanel>
                        <!-- Card 1: Tab Hibernation -->
                        <ui:ModernCard x:Name="CardHibernation" Header="Tab Hibernation" Margin="0,0,0,16">
                            <StackPanel>
                                <CheckBox x:Name="ChkEnableTabHibernation"
                                          Content="Enable inactive tab hibernation"
                                          Checked="ChkEnableTabHibernation_Changed"
                                          Unchecked="ChkEnableTabHibernation_Changed"
                                          Style="{StaticResource SettingsCheckBoxStyle}"/>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LabelTabHibernationTimeout"
                                               Text="Inactivity timeout:"
                                               Style="{StaticResource SettingsRowLabelStyle}"
                                               Margin="0,0,12,0"/>
                                    <ui:ModernComboBox x:Name="ComboTabHibernationTimeout"
                                                       Grid.Column="1"
                                                       Width="160"
                                                       SelectionChanged="ComboTabHibernationTimeout_SelectionChanged">
                                        <ComboBoxItem Content="15 min" Tag="15"/>
                                        <ComboBoxItem Content="30 min" Tag="30"/>
                                        <ComboBoxItem Content="60 min" Tag="60"/>
                                    </ui:ModernComboBox>
                                </Grid>

                                <TextBlock x:Name="TxtTabHibernationHint"
                                           Text="Reduces RAM usage by suspending background tabs when idle. They resume instantly when selected."
                                           Style="{StaticResource SettingsHintTextStyle}"/>
                            </StackPanel>
                        </ui:ModernCard>

                        <!-- Card 2: Cache & Storage -->
                        <ui:ModernCard x:Name="CardCache" Header="Cache &amp; Storage">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LabelDiskCacheLimit"
                                               Text="Chromium disk cache limit:"
                                               Style="{StaticResource SettingsRowLabelStyle}"
                                               Margin="0,0,12,0"/>
                                    <ui:ModernComboBox x:Name="ComboDiskCacheLimit"
                                                       Grid.Column="1"
                                                       Width="180"
                                                       SelectionChanged="ComboDiskCacheLimit_SelectionChanged">
                                        <ComboBoxItem Content="50 MB" Tag="50"/>
                                        <ComboBoxItem Content="128 MB" Tag="128"/>
                                        <ComboBoxItem Content="256 MB" Tag="256"/>
                                        <ComboBoxItem Content="512 MB" Tag="512"/>
                                        <ComboBoxItem Content="1024 MB (1 GB)" Tag="1024"/>
                                        <ComboBoxItem Content="Unlimited" Tag="0"/>
                                    </ui:ModernComboBox>
                                </Grid>

                                <TextBlock x:Name="TxtDiskCacheLimitHint"
                                           Text="Limits disk space used by Chromium HTTP cache per profile (applied upon tab reload)."
                                           Style="{StaticResource SettingsHintTextStyle}"/>

                                <Border Style="{StaticResource SettingsDividerStyle}"/>

                                <!-- Hot Compaction -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtOptimizeStorageHint"
                                               Text="Performs surgical live cache compaction without logging out accounts."
                                               Style="{StaticResource SettingsHintTextStyle}"
                                               Margin="0,0,16,0"
                                               VerticalAlignment="Center"/>
                                    <ui:ModernButton Grid.Column="1"
                                                     x:Name="BtnOptimizeStorage"
                                                     Content="Optimize Space"
                                                     Variant="Secondary"
                                                     IconKey="Sparkles"
                                                     Click="BtnOptimizeStorage_Click"/>
                                </Grid>

                                <!-- Smart Clean Cache -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtSmartCleanCacheHint"
                                               Text="Deletes temporary files, HTTP cache, shaders and GPU cache without logging out (cookies, sessions and IndexedDB remain intact)."
                                               Style="{StaticResource SettingsHintTextStyle}"
                                               Margin="0,0,16,0"
                                               VerticalAlignment="Center"/>
                                    <ui:ModernButton Grid.Column="1"
                                                     x:Name="BtnSmartCleanCache"
                                                     Content="Clean Cache"
                                                     Variant="Secondary"
                                                     IconKey="Trash"
                                                     Click="BtnSmartCleanCache_Click"/>
                                </Grid>
                            </StackPanel>
                        </ui:ModernCard>
                    </StackPanel>
                </ScrollViewer>

                <!-- ========================================== -->
                <!-- PANEL 7: ABOUT & UPDATES                   -->
                <!-- ========================================== -->
                <ScrollViewer x:Name="PanelAbout"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="24,20"
                              Visibility="Collapsed">
                    <StackPanel>
                        <!-- Card 1: Application Info -->
                        <ui:ModernCard Header="HidaChat" Margin="0,0,0,16">
                            <ui:ModernCard.HeaderAction>
                                <ui:StatusBadge x:Name="BadgeAboutVersion"
                                                Text="v0.0.0"
                                                Severity="Info"/>
                            </ui:ModernCard.HeaderAction>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtAboutAppDescription"
                                           Grid.Column="0"
                                           Text="Portable, lightweight, multi-account desktop client for Windows."
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           Margin="0,0,16,0"/>
                                <ui:ModernButton Grid.Column="1"
                                                 x:Name="BtnOpenAboutDialog"
                                                 Content="About"
                                                 Variant="Secondary"
                                                 IconKey="Info"
                                                 Click="BtnAbout_Click"/>
                            </Grid>
                        </ui:ModernCard>

                        <!-- Card 2: Updates -->
                        <ui:ModernCard x:Name="CardUpdates" Header="Updates" Margin="0,0,0,16">
                            <StackPanel>
                                <CheckBox x:Name="ChkUseBetaChannel"
                                          Content="Use beta update channel"
                                          Checked="ChkUseBetaChannel_Changed"
                                          Unchecked="ChkUseBetaChannel_Changed"
                                          Style="{StaticResource SettingsCheckBoxStyle}"/>

                                <Border Style="{StaticResource SettingsDividerStyle}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Check for newer releases on GitHub Releases."
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Margin="0,0,16,0"/>
                                    <ui:ModernButton Grid.Column="1"
                                                     x:Name="BtnCheckUpdates"
                                                     Content="Check Now"
                                                     Variant="Primary"
                                                     IconKey="Download"
                                                     Click="BtnCheckUpdates_Click"/>
                                </Grid>
                            </StackPanel>
                        </ui:ModernCard>

                        <!-- Card 3: Developer Tools -->
                        <ui:ModernCard x:Name="CardDevTools" Header="DevTools">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Inspect elements, console logs, and network traffic for the active tab."
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="0,0,16,0"/>
                                <ui:ModernButton Grid.Column="1"
                                                 x:Name="BtnDebugTab"
                                                 Content="Debug active tab"
                                                 Variant="Secondary"
                                                 IconKey="Settings"
                                                 Click="BtnDevTools_Click"/>
                            </Grid>
                        </ui:ModernCard>
                    </StackPanel>
                </ScrollViewer>

                <!-- Floating Non-Intrusive Toast Notification -->
                <ui:ToastNotification x:Name="SettingsToast"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Bottom"
                                      Margin="24"/>
            </Grid>
        </Grid>

        <!-- Full-Window Loading Overlay for Async Maintenance Operations -->
        <ui:LoadingOverlay x:Name="SettingsLoading"
                           Grid.Column="0"
                           Grid.ColumnSpan="2"
                           Message="Working..."/>
    </Grid>
</Window>
