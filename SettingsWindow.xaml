<Window x:Class="SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HidaChat"
        mc:Ignorable="d"
        Title="Settings" 
        Height="580" 
        Width="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Effect>
        <DropShadowEffect BlurRadius="10" Color="#000" Opacity="0.4" ShadowDepth="0"/>
    </Window.Effect>

    <Window.Resources>
        <ResourceDictionary>
            <Style x:Key="SettingsCloseBtnStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2a3942"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#00a884"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Margin" Value="0,10,0,8"/>
            </Style>

            <Style x:Key="CustomCheckBoxStyle" TargetType="CheckBox">
                <Setter Property="Foreground" Value="#aebac1"/>
                <Setter Property="Margin" Value="0,4"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>

            <Style x:Key="CustomComboBoxStyle" TargetType="ComboBox">
                <Setter Property="Background" Value="#2a3942"/>
                <Setter Property="Foreground" Value="#e9edef"/>
                <Setter Property="BorderBrush" Value="#222e35"/>
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Background" Value="#2a3942"/>
                            <Setter Property="Foreground" Value="#e9edef"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#00a884"/>
                                    <Setter Property="Foreground" Value="#ffffff"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#374955"/>
                                    <Setter Property="Foreground" Value="#ffffff"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ActionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#2a3942"/>
                <Setter Property="Foreground" Value="#e9edef"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#3d525f"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DeleteBtnStyle" TargetType="Button">
                <Setter Property="Background" Value="#ea0038"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#c3002f"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="SettingsBorder" CornerRadius="12" BorderThickness="1" BorderBrush="#2f3e46" Background="#1f2c34">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Titlebar -->
                <RowDefinition Height="45"/>
                <!-- Settings Scrollable Content -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Draggable Titlebar -->
            <Grid Grid.Row="0" x:Name="TitleBar" Background="#202c33" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock x:Name="TitleText" Text="Settings" Foreground="#e9edef" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="20,0,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                    <Button x:Name="BtnAbout" Click="BtnAbout_Click" Width="28" Height="28" Margin="0,0,5,0" ToolTip="About" Style="{StaticResource SettingsCloseBtnStyle}">
                        <TextBlock Text="ⓘ" Foreground="#8696a0" FontSize="14" FontWeight="Bold"/>
                    </Button>
                    <Button Click="BtnClose_Click" Width="28" Height="28" Style="{StaticResource SettingsCloseBtnStyle}">
                        <TextBlock Text="✕" Foreground="#8696a0" FontSize="12" FontWeight="Bold"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Scrollable Settings Page -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="10">
                <StackPanel Margin="10,0,10,15">
                    
                    <!-- THEME SECTION -->
                    <TextBlock x:Name="SectionTheme" Text="Theme" Style="{StaticResource SectionHeaderStyle}"/>
                    <Grid Margin="0,5,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LabelAppTheme" Text="App Theme Color" Foreground="#aebac1" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ComboTheme" Grid.Column="1" Width="120" SelectionChanged="ComboTheme_SelectionChanged" Style="{StaticResource CustomComboBoxStyle}">
                            <ComboBoxItem Content="System"/>
                            <ComboBoxItem Content="Light"/>
                            <ComboBoxItem Content="Dark"/>
                        </ComboBox>
                    </Grid>

                    <!-- LANGUAGE SECTION -->
                    <TextBlock x:Name="SectionLanguage" Text="Language &amp; Translation" Style="{StaticResource SectionHeaderStyle}"/>
                    <Grid Margin="0,5,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LabelSelectLanguage" Text="Select Language" Foreground="#aebac1" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ComboLanguage" Grid.Column="1" Width="150" DisplayMemberPath="Name" SelectionChanged="ComboLanguage_SelectionChanged" Style="{StaticResource CustomComboBoxStyle}"/>
                    </Grid>

                    <CheckBox x:Name="ChkTranslateMessageButton" Content="Translate message button" Checked="ChkSetting_Changed" Unchecked="ChkSetting_Changed" Margin="0,10,0,5" Style="{StaticResource CustomCheckBoxStyle}"/>
                    <CheckBox x:Name="ChkFullPageTranslation" Content="Translate entire page" Checked="ChkSetting_Changed" Unchecked="ChkSetting_Changed" Margin="0,5,0,5" Style="{StaticResource CustomCheckBoxStyle}"/>
                    <CheckBox x:Name="ChkShowTranslateAllButton" Content="Title bar translate all messages button" Checked="ChkSetting_Changed" Unchecked="ChkSetting_Changed" Margin="0,5,0,5" Style="{StaticResource CustomCheckBoxStyle}"/>

                    <!-- NOTIFICATIONS SECTION -->
                    <TextBlock x:Name="SectionNotifications" Text="Notifications" Style="{StaticResource SectionHeaderStyle}"/>
                    <CheckBox x:Name="ChkShowMessagePopup" Content="Show message popup" Checked="ChkSetting_Changed" Unchecked="ChkSetting_Changed" Margin="0,5,0,15" Style="{StaticResource CustomCheckBoxStyle}"/>

                    <!-- ACCOUNTS MANAGEMENT SECTION -->
                    <Grid Margin="0,10,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SectionAccounts" Text="Manage Accounts" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
                        <TextBlock x:Name="TxtAccountsCount" Grid.Column="1" Text="" Foreground="#8696a0" FontSize="12" VerticalAlignment="Center"/>
                    </Grid>
                    
                    <ItemsControl x:Name="AccountsList" Margin="0,5,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,0,0,1" Padding="0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Platform Icon Preview -->
                                        <Path Grid.Column="0" Data="{Binding PlatformIconData}" 
                                              Fill="{Binding PlatformColorBrush}" 
                                              Width="16" Height="16" Stretch="Uniform" 
                                              VerticalAlignment="Center" Margin="0,0,10,0"/>

                                        <!-- Editable Account Name TextBox -->
                                        <TextBox Grid.Column="1" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                 LostFocus="TxtAccountName_LostFocus"
                                                 Foreground="#ffffff" Background="#2a3942" BorderBrush="#00a884" 
                                                 Padding="8,6" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="13"/>

                                        <!-- Platform Selector ComboBox -->
                                        <ComboBox Grid.Column="2" 
                                                  SelectedValuePath="Tag"
                                                  SelectedValue="{Binding Platform, Mode=TwoWay}"
                                                  SelectionChanged="ComboAccountPlatform_SelectionChanged"
                                                  Tag="{Binding Id}"
                                                  Style="{StaticResource CustomComboBoxStyle}"
                                                  VerticalAlignment="Center" Margin="0,0,10,0">
                                            <ComboBoxItem Content="WhatsApp" Tag="WhatsApp"/>
                                            <ComboBoxItem Content="Telegram" Tag="Telegram"/>
                                        </ComboBox>

                                        <!-- Delete Account Button -->
                                        <Button Grid.Column="3" Content="Delete" Click="BtnDeleteAccount_Click" Tag="{Binding Id}" Style="{StaticResource DeleteBtnStyle}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button x:Name="BtnAddAccountSettings" Content="Add account" Click="BtnAddAccountSettings_Click" Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Left" Margin="0,0,0,15"/>

                    <!-- UPDATES SECTION -->
                    <TextBlock x:Name="SectionUpdates" Text="Updates" Style="{StaticResource SectionHeaderStyle}"/>
                    <CheckBox x:Name="ChkUseBetaChannel" Content="Use beta update channel" Checked="ChkUseBetaChannel_Changed" Unchecked="ChkUseBetaChannel_Changed" Margin="0,5,0,10" Style="{StaticResource CustomCheckBoxStyle}"/>

                    <!-- DEVELOPER TOOLS & CACHE -->
                    <TextBlock x:Name="SectionDevTools" Text="DevTools" Style="{StaticResource SectionHeaderStyle}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Button x:Name="BtnDebugTab" Content="Debug active tab" Click="BtnDevTools_Click" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0"/>
                        <Button x:Name="BtnCheckUpdates" Content="Check Now" Click="BtnCheckUpdates_Click" Style="{StaticResource ActionButtonStyle}"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>

</Window>
