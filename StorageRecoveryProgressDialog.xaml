<Window x:Class="StorageRecoveryProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HidaChat"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="440" Height="175">
    <Border Background="#111b21"
            BorderBrush="#00a884"
            BorderThickness="1.5"
            CornerRadius="12"
            Padding="22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="0" Opacity="0.6" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Titolo e Header con icona di storage/database repair -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="36" Height="36" CornerRadius="18" Background="#1f2c34" Margin="0,0,14,0" VerticalAlignment="Center">
                    <Path Data="M12,3C7.58,3 4,4.79 4,7C4,9.21 7.58,11 12,11C16.42,11 20,9.21 20,7C20,4.79 16.42,3 12,3M4,9V12C4,14.21 7.58,16 12,16C16.42,16 20,14.21 20,12V9C20,11.21 16.42,13 12,13C7.58,13 4,11.21 4,9M4,14V17C4,19.21 7.58,21 12,21C16.42,21 20,19.21 20,17V14C20,16.21 16.42,18 12,18C7.58,18 4,16.21 4,14Z"
                          Fill="#00a884" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTitle"
                               Text="HidaChat — Ripristino Storage"
                               Foreground="#e9edef"
                               FontSize="14"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="TxtHeader"
                               Text="Ripristino storage locale in corso..."
                               Foreground="#8696a0"
                               FontSize="12"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Barra di avanzamento indeterminata stile WhatsApp -->
            <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,14,0,10">
                <ProgressBar x:Name="ProgressBarStatus"
                             IsIndeterminate="True"
                             Height="6"
                             Foreground="#00a884"
                             Background="#202c33"
                             BorderThickness="0">
                    <ProgressBar.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="3"/>
                        </Style>
                    </ProgressBar.Resources>
                </ProgressBar>
            </Grid>

            <!-- Dettaglio fase corrente -->
            <TextBlock Grid.Row="2"
                       x:Name="TxtDetail"
                       Text="Verifica integrità database IndexedDB..."
                       Foreground="#00a884"
                       FontSize="11.5"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       HorizontalAlignment="Left"/>
        </Grid>
    </Border>
</Window>
