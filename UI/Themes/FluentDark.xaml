<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Fluent Design Dark Theme Palette -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#273549"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#334155"/>
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="#475569"/>

    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#334155"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#475569"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#60A5FA"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1E3A5F"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E"/>
    <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#143326"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="ErrorSubtleBrush" Color="#3B1A22"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="WarningSubtleBrush" Color="#3A2A15"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#38BDF8"/>
    <SolidColorBrush x:Key="InfoSubtleBrush" Color="#173347"/>

    <SolidColorBrush x:Key="FocusBrush" Color="#3B82F6"/>

</ResourceDictionary>
