<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Fluent Design Light Theme Palette -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="#CBD5E1"/>

    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#CBD5E1"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#475569"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1E40AF"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#EFF6FF"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A"/>
    <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#DCFCE7"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="ErrorSubtleBrush" Color="#FEE2E2"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#D97706"/>
    <SolidColorBrush x:Key="WarningSubtleBrush" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#0284C7"/>
    <SolidColorBrush x:Key="InfoSubtleBrush" Color="#E0F2FE"/>

    <SolidColorBrush x:Key="FocusBrush" Color="#2563EB"/>

</ResourceDictionary>
