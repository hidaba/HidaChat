<Window x:Class="AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WhatsappH"
        mc:Ignorable="d"
        Title="Informazioni su WhatsappH" 
        Height="540" 
        Width="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Effect>
        <DropShadowEffect BlurRadius="12" Color="#000" Opacity="0.5" ShadowDepth="0"/>
    </Window.Effect>

    <Window.Resources>
        <ResourceDictionary>
            <Style x:Key="AboutCloseBtnStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2a3942"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="InfoLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#8696a0"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <Style x:Key="InfoValueStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#e9edef"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Margin" Value="0,2,0,0"/>
            </Style>

            <Style x:Key="AboutActionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#2a3942"/>
                <Setter Property="Foreground" Value="#00a884"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#374955"/>
                                    <Setter Property="Foreground" Value="#25d366"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="AboutBorder" CornerRadius="12" BorderThickness="1" BorderBrush="#2f3e46" Background="#1f2c34">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Titlebar -->
                <RowDefinition Height="45"/>
                <!-- Content -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Draggable Titlebar -->
            <Grid Grid.Row="0" x:Name="TitleBar" Background="#202c33" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock x:Name="TxtTitle" Text="Informazioni su WhatsappH" Foreground="#e9edef" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="20,0,0,0"/>
                <Button Click="BtnClose_Click" HorizontalAlignment="Right" Width="28" Height="28" Margin="0,0,10,0" Style="{StaticResource AboutCloseBtnStyle}">
                    <TextBlock Text="✕" Foreground="#8696a0" FontSize="12" FontWeight="Bold"/>
                </Button>
            </Grid>

            <!-- Main Content -->
            <StackPanel Grid.Row="1" Margin="20,15,20,15">

                <!-- Header Logo & Version -->
                <StackPanel Orientation="Horizontal" Margin="0,5,0,10">
                    <Image Source="images/icon.ico" Width="48" Height="48" Margin="0,0,15,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="WhatsappH" Foreground="#ffffff" FontSize="20" FontWeight="Bold"/>
                            <Border Background="#00a884" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtVersionTag" Text="v0.3.0" Foreground="#ffffff" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="TxtDescription" Text="Client desktop WhatsApp Web portabile, leggero e multi-account per Windows." 
                                   Foreground="#aebac1" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Separator Background="#2a3942" Margin="0,10,0,15"/>

                <!-- Metadata Grid -->
                <Grid Margin="0,0,0,15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Author -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,12">
                        <TextBlock x:Name="LabelAuthor" Text="Autore" Style="{StaticResource InfoLabelStyle}"/>
                        <TextBlock x:Name="TxtAuthor" Text="Massimo Balestrieri (hidaba)" Style="{StaticResource InfoValueStyle}"/>
                    </StackPanel>

                    <!-- Release Date -->
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                        <TextBlock x:Name="LabelReleaseDate" Text="Data di rilascio" Style="{StaticResource InfoLabelStyle}"/>
                        <TextBlock x:Name="TxtReleaseDate" Text="2026-08-06" Style="{StaticResource InfoValueStyle}"/>
                    </StackPanel>

                    <!-- License -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,12">
                        <TextBlock x:Name="LabelLicense" Text="Licenza" Style="{StaticResource InfoLabelStyle}"/>
                        <TextBlock x:Name="TxtLicense" Text="Apache-2.0 License" Style="{StaticResource InfoValueStyle}"/>
                    </StackPanel>

                    <!-- Environment -->
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
                        <TextBlock x:Name="LabelEnvironment" Text="Ambiente e Framework" Style="{StaticResource InfoLabelStyle}"/>
                        <TextBlock x:Name="TxtEnvironment" Text=".NET 9.0 &amp; WebView2" Style="{StaticResource InfoValueStyle}"/>
                    </StackPanel>

                    <!-- Portable Path -->
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,12">
                        <TextBlock x:Name="LabelPortablePath" Text="Percorso Dati Portabile" Style="{StaticResource InfoLabelStyle}"/>
                        <TextBlock x:Name="TxtPortablePath" Text="data/webview (100% Portable)" Style="{StaticResource InfoValueStyle}"/>
                    </StackPanel>

                </Grid>

                <Separator Background="#2a3942" Margin="0,5,0,15"/>

                <!-- Action Buttons / Links -->
                <UniformGrid Columns="3" Margin="0,0,0,15">
                    <Button x:Name="BtnRepo" Content="GitHub Repo" Click="BtnRepo_Click" Style="{StaticResource AboutActionButtonStyle}" Margin="0,0,5,0"/>
                    <Button x:Name="BtnReleases" Content="Vedi Release" Click="BtnReleases_Click" Style="{StaticResource AboutActionButtonStyle}" Margin="2,0,2,0"/>
                    <Button x:Name="BtnIssues" Content="Segnala Bug" Click="BtnIssues_Click" Style="{StaticResource AboutActionButtonStyle}" Margin="5,0,0,0"/>
                </UniformGrid>

                <!-- Footer Close Button -->
                <Button x:Name="BtnCloseBottom" Content="Chiudi" Click="BtnClose_Click" Style="{StaticResource AboutActionButtonStyle}" Background="#202c33" Foreground="#e9edef" HorizontalAlignment="Center" Width="100"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
