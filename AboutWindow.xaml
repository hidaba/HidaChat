<Window x:Class="AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:HidaChat.UI.Controls"
        mc:Ignorable="d"
        Title="About HidaChat"
        Width="490"
        MinWidth="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HidaChat;component/UI/Themes/FluentDark.xaml"/>
                <ResourceDictionary Source="/HidaChat;component/UI/Themes/ModernControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="InfoLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <Style x:Key="InfoValueStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="FontSize" Value="13.5"/>
                <Setter Property="Margin" Value="0,3,0,0"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="24,20,24,22">
        <!-- App Identity Header -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0"
                   Source="images/icon.png"
                   Width="52"
                   Height="52"
                   Margin="0,0,16,0"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   SnapsToDevicePixels="True"
                   UseLayoutRounding="True"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="HidaChat"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <ui:StatusBadge x:Name="BadgeVersion"
                                    Text="v0.0.0"
                                    Severity="Info"
                                    Margin="10,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="TxtDescription"
                           Text="Portable, lightweight, multi-account desktop client for Windows."
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12.5"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Metadata Card -->
        <ui:ModernCard Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                    <TextBlock x:Name="LabelAuthor" Text="Author" Style="{StaticResource InfoLabelStyle}"/>
                    <TextBlock x:Name="TxtAuthor" Text="Massimo Balestrieri (hidaba)" Style="{StaticResource InfoValueStyle}"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                    <TextBlock x:Name="LabelReleaseDate" Text="Release Date" Style="{StaticResource InfoLabelStyle}"/>
                    <TextBlock x:Name="TxtReleaseDate" Text="2026-11-27" Style="{StaticResource InfoValueStyle}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                    <TextBlock x:Name="LabelLicense" Text="License" Style="{StaticResource InfoLabelStyle}"/>
                    <TextBlock x:Name="TxtLicense" Text="Apache-2.0 License" Style="{StaticResource InfoValueStyle}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                    <TextBlock x:Name="LabelEnvironment" Text="Runtime Environment" Style="{StaticResource InfoLabelStyle}"/>
                    <TextBlock x:Name="TxtEnvironment" Text=".NET 9.0 &amp; WebView2" Style="{StaticResource InfoValueStyle}"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                    <TextBlock x:Name="LabelPortablePath" Text="Portable Data Directory" Style="{StaticResource InfoLabelStyle}"/>
                    <TextBlock x:Name="TxtPortablePath" Text="data/webview (100% Portable)" Style="{StaticResource InfoValueStyle}"/>
                </StackPanel>
            </Grid>
        </ui:ModernCard>

        <!-- External Links -->
        <UniformGrid Columns="3" Margin="0,0,0,16">
            <ui:ModernButton x:Name="BtnRepo" Content="GitHub Repo" Variant="Secondary" Click="BtnRepo_Click" Margin="0,0,6,0"/>
            <ui:ModernButton x:Name="BtnReleases" Content="Releases" Variant="Secondary" Click="BtnReleases_Click" Margin="3,0,3,0"/>
            <ui:ModernButton x:Name="BtnIssues" Content="Report Issue" Variant="Secondary" Click="BtnIssues_Click" Margin="6,0,0,0"/>
        </UniformGrid>

        <!-- Close Button -->
        <ui:ModernButton x:Name="BtnCloseBottom"
                         Content="Close"
                         Variant="Primary"
                         IsCancel="True"
                         IsDefault="True"
                         MinWidth="112"
                         HorizontalAlignment="Right"
                         Click="BtnClose_Click"/>
    </StackPanel>
</Window>
