<Window x:Class="ShutdownProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HidaChat"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="430" Height="170">
    <Border Background="#111b21"
            BorderBrush="#00a884"
            BorderThickness="1.5"
            CornerRadius="12"
            Padding="22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="0" Opacity="0.6" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Titolo e Header con icona di salvataggio/chiusura -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="34" Height="34" CornerRadius="17" Background="#1f2c34" Margin="0,0,14,0" VerticalAlignment="Center">
                    <Path Data="M19,12H17V15H7V9H15V7H5A2,2 0 0,0 3,9V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V12M19,3A2,2 0 0,1 21,5V7H19V5H5V7H3V5A2,2 0 0,1 5,3H19M21,8V10H19V8H21Z"
                          Fill="#00a884" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTitle"
                               Text="HidaChat"
                               Foreground="#e9edef"
                               FontSize="14"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="TxtHeader"
                               Text="Salvataggio dati e chiusura in corso..."
                               Foreground="#8696a0"
                               FontSize="12"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Barra di avanzamento indeterminata stile WhatsApp -->
            <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,14,0,10">
                <ProgressBar x:Name="ProgressBarStatus"
                             IsIndeterminate="True"
                             Height="6"
                             Foreground="#00a884"
                             Background="#202c33"
                             BorderThickness="0">
                    <ProgressBar.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="3"/>
                        </Style>
                    </ProgressBar.Resources>
                </ProgressBar>
            </Grid>

            <!-- Dettaglio fase corrente -->
            <TextBlock Grid.Row="2"
                       x:Name="TxtDetail"
                       Text="Attendere..."
                       Foreground="#00a884"
                       FontSize="11.5"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       HorizontalAlignment="Left"/>
        </Grid>
    </Border>
</Window>
