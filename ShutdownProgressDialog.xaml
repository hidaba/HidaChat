<Window x:Class="ShutdownProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HidaChat — Closing"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="430"
        Height="170"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HidaChat;component/UI/Themes/FluentDark.xaml"/>
                <ResourceDictionary Source="/HidaChat;component/UI/Themes/ModernControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="1.5"
            Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header with save/shutdown icon -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="38"
                        Height="38"
                        CornerRadius="10"
                        Background="{DynamicResource AccentSubtleBrush}"
                        Margin="0,0,14,0"
                        VerticalAlignment="Center">
                    <Path Data="M17,3H5C3.89,3 3,3.9 3,5V19C3,20.1 3.89,21 5,21H19C20.1,21 21,20.1 21,19V7L17,3ZM12,19C10.34,19 9,17.66 9,16C9,14.34 10.34,13 12,13C13.66,13 15,14.34 15,16C15,17.66 13.66,19 12,19ZM15,9H5V5H15V9Z"
                          Fill="{DynamicResource AccentBrush}"
                          Width="18"
                          Height="18"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTitle"
                               Text="HidaChat"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="15"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtHeader"
                               Text="Saving data and closing..."
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12.5"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Indeterminate progress bar -->
            <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,14,0,10">
                <ProgressBar x:Name="ProgressBarStatus"
                             IsIndeterminate="True"
                             Height="6"
                             Foreground="{DynamicResource AccentBrush}"
                             Background="{DynamicResource SurfaceElevatedBrush}"
                             BorderThickness="0"/>
            </Grid>

            <!-- Current step detail -->
            <TextBlock Grid.Row="2"
                       x:Name="TxtDetail"
                       Text="Please wait..."
                       Foreground="{DynamicResource AccentBrush}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       HorizontalAlignment="Left"/>
        </Grid>
    </Border>
</Window>
