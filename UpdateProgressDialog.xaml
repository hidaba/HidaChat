<Window x:Class="UpdateProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HidaChat"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        Width="460" Height="190">
    <Border Background="#111b21"
            BorderBrush="#00a884"
            BorderThickness="1.5"
            CornerRadius="12"
            Padding="22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="0" Opacity="0.6" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Titolo e Header con icona di aggiornamento/download -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="36" Height="36" CornerRadius="18" Background="#1f2c34" Margin="0,0,14,0" VerticalAlignment="Center">
                    <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M11,7V13H8L12,17L16,13H13V7H11Z"
                          Fill="#00a884" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTitle"
                               Text="HidaChat"
                               Foreground="#e9edef"
                               FontSize="14"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="TxtHeader"
                               Text="Aggiornamento in corso..."
                               Foreground="#8696a0"
                               FontSize="12"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Barra di avanzamento stile WhatsApp (supporta determinata e indeterminata) -->
            <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,14,0,10">
                <ProgressBar x:Name="ProgressBarStatus"
                             IsIndeterminate="False"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Height="6"
                             Foreground="#00a884"
                             Background="#202c33"
                             BorderThickness="0">
                    <ProgressBar.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="3"/>
                        </Style>
                    </ProgressBar.Resources>
                </ProgressBar>
            </Grid>

            <!-- Dettaglio fase corrente e info progresso (MB / percentuale) -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           x:Name="TxtDetail"
                           Text="Preparazione aggiornamento..."
                           Foreground="#00a884"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           x:Name="TxtProgressInfo"
                           Text=""
                           Foreground="#8696a0"
                           FontSize="11"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
