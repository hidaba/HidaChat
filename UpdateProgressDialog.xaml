<Window x:Class="UpdateProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HidaChat — Update"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Topmost="True"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        Width="460"
        Height="186"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HidaChat;component/UI/Themes/FluentDark.xaml"/>
                <ResourceDictionary Source="/HidaChat;component/UI/Themes/ModernControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="1.5"
            Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header with download icon -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="38"
                        Height="38"
                        CornerRadius="10"
                        Background="{DynamicResource AccentSubtleBrush}"
                        Margin="0,0,14,0"
                        VerticalAlignment="Center">
                    <Path Data="M19,9H15V3H9V9H5L12,16L19,9ZM5,18V20H19V18H5Z"
                          Fill="{DynamicResource AccentBrush}"
                          Width="18"
                          Height="18"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTitle"
                               Text="HidaChat"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="15"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtHeader"
                               Text="Updating HidaChat..."
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12.5"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Progress bar -->
            <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,14,0,10">
                <ProgressBar x:Name="ProgressBarStatus"
                             IsIndeterminate="False"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Height="6"
                             Foreground="{DynamicResource AccentBrush}"
                             Background="{DynamicResource SurfaceElevatedBrush}"
                             BorderThickness="0"/>
            </Grid>

            <!-- Stage detail & transfer progress -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           x:Name="TxtDetail"
                           Text="Preparing update..."
                           Foreground="{DynamicResource AccentBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           x:Name="TxtProgressInfo"
                           Text=""
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="11.5"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
