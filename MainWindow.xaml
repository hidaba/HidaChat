<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WhatsAppVB"
        mc:Ignorable="d"
        Title="WhatsApp" 
        Height="700" 
        Width="1000"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <!-- Design styles -->
            <Style x:Key="HeaderIconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2a3942"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AccountTabButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#8696a0"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="15" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#e9edef"/>
                                    <Setter Property="Background" Value="#202c33"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AddAccountButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#00a884"/>
                <Setter Property="Foreground" Value="#ffffff"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#008f72"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Subtle DropShadow around the window -->
    <Window.Effect>
        <DropShadowEffect BlurRadius="15" Color="#000" Opacity="0.3" ShadowDepth="0"/>
    </Window.Effect>

    <Border x:Name="RootBorder" CornerRadius="12" BorderThickness="1" BorderBrush="#2f3e46" Background="#111b21">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Titlebar Row -->
                <RowDefinition Height="45"/>
                <!-- Accounts/Tabs Row -->
                <RowDefinition Height="Auto"/>
                <!-- WebView Content Row -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Draggable Titlebar -->
            <Grid Grid.Row="0" x:Name="TitleBar" Background="#202c33" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon and Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                    <Image Source="images/icon.ico" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock x:Name="TitleText" Text="WhatsApp" Foreground="#e9edef" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Quick actions and window controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    
                    <!-- Translate Full Page Button -->
                    <Button x:Name="BtnTranslatePage" Click="BtnTranslatePage_Click" Width="32" Height="32" Margin="0,0,5,0" ToolTip="Translate entire page" Style="{StaticResource HeaderIconButtonStyle}">
                        <Path Data="M12,2C6.48,2,2,6.48,2,12s4.48,10,10,10s10-4.48,10-10S17.52,2,12,2z M18.93,8h-2.95c-0.32-1.25-0.78-2.45-1.38-3.56 C16.44,5.07,17.97,6.35,18.93,8z M12,4.04c0.83,1.2,1.48,2.53,1.91,3.96h-3.82C10.52,6.57,11.17,5.24,12,4.04z M4.26,14 C4.1,13.36,4,12.69,4,12s0.1-1.36,0.26-2h3.38c-0.08,0.66-0.14,1.34-0.14,2s0.06,1.34,0.14,2H4.26z M5.08,16h2.95 c0.32,1.25,0.78,2.45,1.38,3.56C7.57,18.93,6.04,17.65,5.08,16z M8.03,8C8.35,6.75,8.81,5.55,9.41,4.44 C7.57,5.07,6.04,6.35,5.08,8H8.03z M12,19.96c-0.83-1.2-1.48-2.53-1.91-3.96h3.82C13.48,17.43,12.83,18.76,12,19.96z M14.34,14H9.66 c-0.09-0.66-0.16-1.34-0.16-2s0.07-1.34,0.16-2h4.68c0.09,0.66,0.16,1.34,0.16,2S14.43,14,14.34,14z M14.62,19.56 c0.6-1.11,1.06-2.31,1.38-3.56h2.95C17.97,17.65,16.44,18.93,14.62,19.56z M16.36,14c0.08-0.66,0.14-1.34,0.14-2s-0.06-1.34-0.14-2 h3.38c0.16,0.64,0.26,1.31,0.26,2s-0.1,1.36-0.26,2H16.36z" 
                              Fill="#8696a0" Width="18" Height="18" Stretch="Fill"/>
                    </Button>

                    <!-- Reload Active Tab Button -->
                    <Button x:Name="BtnReloadActiveTab" Click="BtnReloadActiveTab_Click" Width="32" Height="32" Margin="0,0,5,0" ToolTip="Reload active tab" Style="{StaticResource HeaderIconButtonStyle}">
                        <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z" 
                              Fill="#8696a0" Width="16" Height="16" Stretch="Fill"/>
                    </Button>

                    <!-- Settings Button -->
                    <Button x:Name="BtnSettings" Click="BtnSettings_Click" Width="32" Height="32" Margin="0,0,15,0" ToolTip="Settings" Style="{StaticResource HeaderIconButtonStyle}">
                        <Path Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 c-0.12,0.21-0.08,0.47,0.12,0.61l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12c0,0.31,0.02,0.64,0.07,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.21,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z" 
                              Fill="#8696a0" Width="16" Height="16" Stretch="Fill"/>
                    </Button>

                    <!-- Minimize Button -->
                    <Button Click="BtnMinimize_Click" Width="28" Height="28" Margin="0,0,5,0" Style="{StaticResource HeaderIconButtonStyle}">
                        <TextBlock Text="—" Foreground="#8696a0" FontSize="12" FontWeight="Bold"/>
                    </Button>

                    <!-- Close/Tray Button -->
                    <Button Click="BtnClose_Click" Width="28" Height="28" Style="{StaticResource HeaderIconButtonStyle}">
                        <TextBlock Text="✕" Foreground="#8696a0" FontSize="12" FontWeight="Bold"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Custom Horizontal Account Bar -->
            <Border Grid.Row="1" Background="#111b21" BorderThickness="0,0,0,1" BorderBrush="#222e35" Padding="10,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Horizontal list of accounts -->
                    <ItemsControl x:Name="AccountsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}" 
                                        Click="AccountTab_Click"
                                        Tag="{Binding Id}"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource AccountTabButtonStyle}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Quick add account button -->
                    <Button Grid.Column="1" Click="BtnAddAccount_Click" Content="+ Add Account" Style="{StaticResource AddAccountButtonStyle}"/>
                </Grid>
            </Border>

            <!-- Main WebViews Holder Grid -->
            <Grid Grid.Row="2" x:Name="WebViewsGrid" Background="#0b141a">
                <!-- WebView2 controls will be populated dynamically in VB.NET -->
            </Grid>
        </Grid>
    </Border>
</Window>
