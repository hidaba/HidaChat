<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HidaChat"
        mc:Ignorable="d"
        Title="HidaChat" 
        Height="700" 
        Width="1000"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="MainWindow_PreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <!-- Design styles -->
            <Style x:Key="HeaderIconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2a3942"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AccountTabButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#8696a0"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="15" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#e9edef"/>
                                    <Setter Property="Background" Value="#202c33"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                        <Setter Property="Background" Value="#202c33"/>
                        <Setter Property="Foreground" Value="#00a884"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>


            <Style x:Key="AddAccountTabButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#8696a0"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="14">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#00a884"/>
                                    <Setter Property="Background" Value="#202c33"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="#3b4a54"/>
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <!-- Subtle DropShadow around the window -->
    <Window.Effect>
        <DropShadowEffect BlurRadius="15" Color="#000" Opacity="0.3" ShadowDepth="0"/>
    </Window.Effect>

    <Border x:Name="RootBorder" CornerRadius="12" BorderThickness="1" BorderBrush="#2f3e46" Background="#111b21">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Titlebar Row -->
                <RowDefinition Height="45"/>
                <!-- Accounts/Tabs Row -->
                <RowDefinition Height="Auto"/>
                <!-- WebView Content Row -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Draggable Titlebar -->
            <Grid Grid.Row="0" x:Name="TitleBar" Background="#202c33" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" MouseMove="TitleBar_MouseMove">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon and Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                    <Image Source="images/icon.ico" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock x:Name="TitleText" Text="HidaChat" Foreground="#e9edef" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>

                    <!-- Online Contact Indicator (TODO #42) -->
                    <Border x:Name="OnlineIndicatorBorder" 
                            Background="#1b3d2f" 
                            CornerRadius="10" 
                            Padding="8,3" 
                            Margin="12,0,0,0" 
                            VerticalAlignment="Center" 
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="OnlineDot" Width="7" Height="7" Fill="#25d366" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="OnlineStatusText" Text="in linea" Foreground="#25d366" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Quick actions and window controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">

                    <!-- Version number -->
                    <TextBlock x:Name="VersionText" Text="" Foreground="#8696a0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <!-- Bulk Sender (Excel / CSV) Button -->
                    <Button x:Name="BtnBulkSender" Click="BtnBulkSender_Click" Width="32" Height="32" Margin="0,0,5,0" ToolTip="Invio Massivo da Excel / CSV" Style="{StaticResource HeaderIconButtonStyle}">
                        <Path Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M15.8,20H14L12,16.6L10,20H8.2L11.1,15.5L8.4,11H10.2L12,14.4L13.8,11H15.6L12.9,15.5L15.8,20M13,9V3.5L18.5,9H13Z" 
                              Fill="#00a884" Width="16" Height="16" Stretch="Fill"/>
                    </Button>

                    <!-- Reload Active Tab Button -->
                    <Button x:Name="BtnReloadActiveTab" Click="BtnReloadActiveTab_Click" Width="32" Height="32" Margin="0,0,5,0" ToolTip="Reload active tab" Style="{StaticResource HeaderIconButtonStyle}">
                        <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z" 
                              Fill="#8696a0" Width="16" Height="16" Stretch="Fill"/>
                    </Button>

                    <!-- About Button -->
                    <Button x:Name="BtnAbout" Click="BtnAbout_Click" Width="32" Height="32" Margin="0,0,5,0" ToolTip="About" Style="{StaticResource HeaderIconButtonStyle}">
                        <TextBlock Text="ⓘ" Foreground="#8696a0" FontSize="14" FontWeight="Bold"/>
                    </Button>

                    <!-- Settings Button -->
                    <Button x:Name="BtnSettings" Click="BtnSettings_Click" Width="32" Height="32" Margin="0,0,15,0" ToolTip="Settings" Style="{StaticResource HeaderIconButtonStyle}">
                        <Path Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 c-0.12,0.21-0.08,0.47,0.12,0.61l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12c0,0.31,0.02,0.64,0.07,0.94l-2.03,1.58 c-0.18,0.14-0.23-0.41-0.12-0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.21,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z" 
                              Fill="#8696a0" Width="16" Height="16" Stretch="Fill"/>
                    </Button>

                    <!-- Minimize Button -->
                    <Button Click="BtnMinimize_Click" Width="28" Height="28" Margin="0,0,5,0" Style="{StaticResource HeaderIconButtonStyle}">
                        <TextBlock Text="—" Foreground="#8696a0" FontSize="12" FontWeight="Bold"/>
                    </Button>

                    <!-- Maximize/Restore Button -->
                    <Button x:Name="BtnMaximize" Click="BtnMaximize_Click" Width="28" Height="28" Margin="0,0,5,0" Style="{StaticResource HeaderIconButtonStyle}">
                        <Path x:Name="MaximizeIcon" Data="M0,0 L12,0 L12,12 L0,12 Z M1,1 L1,11 L11,11 L1,1 Z" 
                              Fill="#8696a0" Width="12" Height="12" Stretch="Fill"/>
                    </Button>

                    <!-- Close/Tray Button -->
                    <Button Click="BtnClose_Click" Width="28" Height="28" Style="{StaticResource HeaderIconButtonStyle}">
                        <TextBlock Text="✕" Foreground="#8696a0" FontSize="12" FontWeight="Bold"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Custom Horizontal Account Bar -->
            <Border Grid.Row="1" Background="#111b21" BorderThickness="0,0,0,1" BorderBrush="#222e35" Padding="10,5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <!-- Horizontal list of accounts -->
                    <ItemsControl x:Name="AccountsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="AccountTab_Click"
                                        Tag="{Binding Id}"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource AccountTabButtonStyle}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{Binding PlatformIconData}" 
                                              Fill="{Binding PlatformColorBrush}" 
                                              Width="14" Height="14" Stretch="Uniform" 
                                              VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                        <Ellipse x:Name="TabOnlineDot" Width="6" Height="6" Fill="#25d366" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                        <Border x:Name="UnreadBadge"
                                                Background="#e53935"
                                                CornerRadius="7"
                                                MinWidth="16"
                                                Height="16"
                                                Padding="4,0"
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                Visibility="Collapsed">
                                            <TextBlock Text="{Binding UnreadBadgeText}"
                                                       Foreground="#ffffff"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Rename" Click="AccountTabRename_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding HasUnreadBadge}" Value="True">
                                        <Setter TargetName="UnreadBadge" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsContactOnline}" Value="True">
                                        <Setter TargetName="TabOnlineDot" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Add Account Button -->
                    <Button x:Name="BtnAddAccount" Content="+" Click="BtnAddAccount_Click" ToolTip="Aggiungi account (max 3)" Style="{StaticResource AddAccountTabButtonStyle}" Margin="4,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- Main WebViews Holder Grid -->
            <Grid Grid.Row="2" x:Name="WebViewsGrid" Background="#0b141a">
                <!-- WebView2 controls will be populated dynamically in VB.NET -->
            </Grid>

            <!-- Resize grip -->
            <Grid x:Name="ResizeGrip" Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2" Width="14" Height="14"
                  Background="Transparent" Cursor="SizeNWSE" PreviewMouseLeftButtonDown="ResizeGrip_PreviewMouseLeftButtonDown">
                <Path HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2"
                      Data="M0,6 L6,12 M0,10 L2,12 M4,10 L6,12" Stroke="#8696a0" StrokeThickness="1.5" IsHitTestVisible="False"/>
            </Grid>
        </Grid>
    </Border>
</Window>
