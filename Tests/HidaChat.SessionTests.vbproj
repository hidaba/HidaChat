<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>HidaChat</RootNamespace>
    <OptionStrict>On</OptionStrict>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>NO_WPF=True</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../PlatformDefinition.vb" Link="PlatformDefinition.vb" />
    <Compile Include="../SessionRecoveryPolicy.vb" Link="SessionRecoveryPolicy.vb" />
    <Compile Include="../ColdProfileCopy.vb" Link="ColdProfileCopy.vb" />
    <Compile Include="../NetworkProfileSync.vb" Link="NetworkProfileSync.vb" />
    <Compile Include="../LocalAuthPolicy.vb" Link="LocalAuthPolicy.vb" />
    <Compile Include="../TranslationProvider.vb" Link="TranslationProvider.vb" />
    <Compile Include="SessionTests.vb" />
  </ItemGroup>
</Project>
