<Window x:Class="MessagePopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        AllowsTransparency="True"
        Background="Transparent"
        Width="350" Height="82"
        ResizeMode="NoResize">
    <Border CornerRadius="10" Background="#1f2c34" BorderBrush="#2f3e46" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid MouseDown="PopupGrid_MouseDown" Cursor="Hand">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="62"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Avatar with overlapping Platform Badge -->
                <Grid Grid.Column="0" Width="46" Height="46" Margin="8,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <!-- Contact Initials Circle -->
                    <Border x:Name="AvatarBorder" Width="40" Height="40" CornerRadius="20"
                            Background="#00a884" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <TextBlock Name="InitialsText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                    </Border>
                    <!-- Platform Icon Badge (WhatsApp / Telegram) -->
                    <Border x:Name="PlatformBadgeBorder" Width="20" Height="20" CornerRadius="10"
                            Background="#25d366" BorderBrush="#1f2c34" BorderThickness="2"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <Path x:Name="PlatformBadgeIcon" 
                              Data="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 15 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67M8.53 7.33C8.37 7.33 8.1 7.39 7.87 7.64C7.65 7.89 7.02 8.48 7.02 9.68C7.02 10.88 7.9 12.03 8.02 12.19C8.14 12.35 9.73 14.81 12.18 15.86C12.76 16.11 13.22 16.26 13.57 16.37C14.16 16.56 14.69 16.53 15.11 16.47C15.59 16.4 16.58 15.87 16.78 15.3C16.98 14.73 16.98 14.24 16.92 14.14C16.86 14.04 16.7 13.98 16.45 13.85C16.2 13.73 14.97 13.12 14.74 13.04C14.52 12.96 14.35 12.92 14.19 13.17C14.03 13.41 13.56 13.98 13.42 14.14C13.28 14.31 13.13 14.33 12.89 14.21C12.64 14.08 11.84 13.82 10.89 12.97C10.15 12.31 9.65 11.5 9.51 11.25C9.36 11.01 9.5 10.87 9.62 10.75C9.73 10.64 9.87 10.45 10 10.31C10.13 10.16 10.17 10.06 10.25 9.9C10.33 9.73 10.29 9.59 10.23 9.47C10.17 9.35 9.7 8.19 9.5 7.72C9.31 7.26 9.12 7.32 8.97 7.31C8.84 7.31 8.68 7.33 8.53 7.33Z" 
                              Fill="White" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
                
                <!-- Sender and Message Body -->
                <StackPanel Grid.Column="1" Margin="4,0,28,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Name="NameText" Foreground="#e9edef" FontWeight="SemiBold"
                                   FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                        <TextBlock Name="PlatformNameText" Foreground="#8696a0" FontSize="11"
                                   Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="Normal"/>
                    </StackPanel>
                    <TextBlock Name="MessageText" Foreground="#8696a0" FontSize="12"
                               TextTrimming="CharacterEllipsis" MaxHeight="32" TextWrapping="NoWrap" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
            <Button Name="CloseBtn" Background="Transparent" BorderThickness="0"
                    Foreground="#8696a0" FontSize="16" Content="×"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Width="24" Height="24" Margin="0,4,4,0"
                    Click="CloseBtn_Click" Focusable="False" Cursor="Arrow"/>
        </Grid>
    </Border>
</Window>