<Window x:Class="MessagePopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        AllowsTransparency="True"
        Background="Transparent"
        Width="340" Height="78"
        ResizeMode="NoResize">
    <Border CornerRadius="8" Background="#1f2c34" BorderBrush="#2f3e46" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid MouseDown="PopupGrid_MouseDown" Cursor="Hand">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                        Background="#00a884" Margin="6,0,0,0" VerticalAlignment="Center">
                    <TextBlock Name="InitialsText" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="4,0,8,0" VerticalAlignment="Center">
                    <TextBlock Name="NameText" Foreground="#e9edef" FontWeight="SemiBold"
                               FontSize="13" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Name="MessageText" Foreground="#8696a0" FontSize="12"
                               TextTrimming="CharacterEllipsis" MaxHeight="32" TextWrapping="NoWrap"/>
                </StackPanel>
            </Grid>
            <Button Name="CloseBtn" Background="Transparent" BorderThickness="0"
                    Foreground="#8696a0" FontSize="16" Content="×"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Width="24" Height="24" Margin="0,4,4,0"
                    Click="CloseBtn_Click" Focusable="False" Cursor="Arrow"/>
        </Grid>
    </Border>
</Window>