<Window x:Class="MessagePopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HidaChat Notification"
        WindowStyle="None"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Width="360"
        Height="88"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HidaChat;component/UI/Themes/FluentDark.xaml"/>
                <ResourceDictionary Source="/HidaChat;component/UI/Themes/ModernControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="PopupCloseBtnStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBg" Background="{TemplateBinding Background}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBg" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Semantic Platform Accent Indicator Bar -->
            <Border x:Name="AccentIndicatorBar" Grid.Column="0" Background="{DynamicResource AccentBrush}"/>

            <Grid Grid.Column="1">
                <Grid MouseDown="PopupGrid_MouseDown" Cursor="Hand">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="62"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Avatar with overlapping Platform Badge -->
                    <Grid Grid.Column="0" Width="46" Height="46" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Border x:Name="AvatarBorder" Width="40" Height="40" CornerRadius="20"
                                Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <TextBlock Name="InitialsText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentForegroundBrush}" FontSize="14" FontWeight="SemiBold"/>
                        </Border>
                        <Border x:Name="PlatformBadgeBorder" Width="20" Height="20" CornerRadius="10"
                                Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource SurfaceBrush}" BorderThickness="2"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <Path x:Name="PlatformBadgeIcon"
                                  Data="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2Z"
                                  Fill="{DynamicResource AccentForegroundBrush}" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- Sender and Message Body -->
                    <StackPanel Grid.Column="1" Margin="6,0,32,0" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Name="NameText"
                                       Grid.Column="0"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="13.5"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                            <TextBlock Name="PlatformNameText"
                                       Grid.Column="1"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="11.5"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       FontWeight="Normal"/>
                        </Grid>
                        <TextBlock Name="MessageText"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12.5"
                                   LineHeight="17"
                                   TextTrimming="CharacterEllipsis"
                                   MaxHeight="36"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Dismiss button -->
                <Button Name="CloseBtn"
                        Style="{StaticResource PopupCloseBtnStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Width="24"
                        Height="24"
                        Margin="0,6,6,0"
                        ToolTip="Dismiss"
                        AutomationProperties.Name="Dismiss notification"
                        Click="CloseBtn_Click">
                    <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                          Fill="{DynamicResource TextMutedBrush}"
                          Width="10"
                          Height="10"
                          Stretch="Uniform"/>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
