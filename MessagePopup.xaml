<Window x:Class="MessagePopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HidaChat Notification"
        WindowStyle="None"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Width="360"
        SizeToContent="Height"
        MinHeight="84"
        MaxHeight="136"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HidaChat;component/UI/Themes/FluentDark.xaml"/>
                <ResourceDictionary Source="/HidaChat;component/UI/Themes/ModernControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="PopupCloseBtnStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBg" Background="{TemplateBinding Background}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBg" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Semantic Platform Accent Indicator Bar -->
            <Border x:Name="AccentIndicatorBar" Grid.Column="0" Background="{DynamicResource AccentBrush}"/>

            <Grid Grid.Column="1">
                <Grid MouseDown="PopupGrid_MouseDown" Cursor="Hand" Margin="12,10,12,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Header: Chat Platform Logo + Sender Name (without repeating platform name on top-right) -->
                    <Grid Grid.Row="0" Margin="0,0,28,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="PlatformBadgeBorder"
                                Grid.Column="0"
                                Width="22"
                                Height="22"
                                CornerRadius="6"
                                Background="{DynamicResource AccentBrush}"
                                VerticalAlignment="Center">
                            <Path x:Name="PlatformBadgeIcon"
                                  Data="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2Z"
                                  Fill="{DynamicResource AccentForegroundBrush}"
                                  Width="12"
                                  Height="12"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Name="NameText"
                                   Grid.Column="1"
                                   Margin="8,0,0,0"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontFamily="Segoe UI, Segoe UI Emoji"
                                   FontWeight="SemiBold"
                                   FontSize="13.5"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Message Preview + Optional Emoji/Image Miniature -->
                    <Grid Grid.Row="1" Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Name="MessageText"
                                   Grid.Column="0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI, Segoe UI Emoji"
                                   FontSize="12.5"
                                   LineHeight="17"
                                   LineStackingStrategy="BlockLineHeight"
                                   TextTrimming="CharacterEllipsis"
                                   MaxHeight="34"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>

                        <Border x:Name="MediaPreviewBorder"
                                Grid.Column="1"
                                Width="42"
                                Height="42"
                                Margin="10,0,0,0"
                                CornerRadius="6"
                                Background="{DynamicResource SurfaceElevatedBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                ClipToBounds="True"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                            <Grid>
                                <Image x:Name="MediaThumbnailImage"
                                       Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Visibility="Collapsed"/>
                                <TextBlock x:Name="EmojiThumbnailText"
                                           FontFamily="Segoe UI Emoji, Segoe UI"
                                           FontSize="22"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Dismiss button -->
                <Button Name="CloseBtn"
                        Style="{StaticResource PopupCloseBtnStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Width="24"
                        Height="24"
                        Margin="0,8,8,0"
                        ToolTip="Dismiss"
                        AutomationProperties.Name="Dismiss notification"
                        Click="CloseBtn_Click">
                    <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                          Fill="{DynamicResource TextMutedBrush}"
                          Width="10"
                          Height="10"
                          Stretch="Uniform"/>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
